--- a/configure
+++ b/configure
@@ -981,10 +981,20 @@ get_pwd() {
     fi
 }

-meson="$(cd pyvenv/bin; get_pwd)/meson"
-if [ -f "$meson$EXESUF" ]; then
-  meson="$meson$EXESUF"
+# conda-forge: Use Scripts dir for Windows compatibility. Hardcode the
+# .exe suffix (rather than relying on QEMU's $EXESUF) since this patch
+# only ever applies on the Windows (non-unix) build path, where EXESUF
+# is not reliably set yet at this point in configure.
+meson="$PWD/pyvenv/Scripts/meson"
+if [ -f "$meson.exe" ]; then
+  meson="$meson.exe"
 fi
+{
+  echo "CONDA-DEBUG: meson-locate test: [ -f \"\$PWD/pyvenv/Scripts/meson.exe\" ] -> $([ -f "$PWD/pyvenv/Scripts/meson.exe" ] && echo TRUE || echo FALSE)"
+  echo "CONDA-DEBUG: resolved \$meson variable = ${meson}"
+  echo "CONDA-DEBUG: ls -la of pyvenv/Scripts/meson* at configure-time:"
+  ls -la "$PWD"/pyvenv/Scripts/meson* 2>&1
+} >> "${SRC_DIR}/_conda_debug.log" 2>&1 || true

 # On Haiku, meson might show up in a "non-packaged" subfolder instead, see
 # https://github.com/haiku/haiku/blob/r1beta5/docs/user/storage/storageintro.dox
