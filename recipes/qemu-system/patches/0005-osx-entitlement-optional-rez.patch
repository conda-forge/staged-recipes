--- scripts/entitlement.sh.orig
+++ scripts/entitlement.sh
@@ -25,9 +25,11 @@
   codesign --entitlements "$ENTITLEMENT" --force -s - "$SRC"
 fi

-# Add the QEMU icon to the binary on Mac OS
-Rez -append "$ICON" -o "$SRC"
-SetFile -a C "$SRC"
+# Add the QEMU icon to the binary on Mac OS (best-effort: Rez and SetFile are
+# Carbon-era Xcode tools whose wrapper can fail to locate an SDK on modern
+# Xcode; the icon is purely cosmetic, so do not fail the install over it)
+Rez -append "$ICON" -o "$SRC" 2>/dev/null || :
+SetFile -a C "$SRC" 2>/dev/null || :

 mv -f "$SRC" "$DST"
 trap '' exit
