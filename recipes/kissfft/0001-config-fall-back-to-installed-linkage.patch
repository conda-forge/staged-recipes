--- a/kissfft-config.cmake.in
+++ b/kissfft-config.cmake.in
@@ -50,6 +50,15 @@
 # Load information for all configured kissfft
 get_filename_component(_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)
 file(GLOB CONFIG_FILES "${_DIR}/${_kissfft_config_glob}")
+# If no SHARED/STATIC component was requested and only the other linkage is
+# installed, use that instead of finding nothing.
+if(NOT CONFIG_FILES AND NOT _kissfft_shared_detected)
+    if(_kissfft_shared)
+        file(GLOB CONFIG_FILES "${_DIR}/kissfft-*-static-targets.cmake")
+    else()
+        file(GLOB CONFIG_FILES "${_DIR}/kissfft-*-shared-targets.cmake")
+    endif()
+endif()
 foreach(f ${CONFIG_FILES})
   include(${f})
 endforeach()
