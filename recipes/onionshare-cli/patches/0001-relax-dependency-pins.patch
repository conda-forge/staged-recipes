Relax the dependency pins to what conda-forge ships.

* setuptools, wheel, cffi, cython and pkgconfig are only needed to build the
  pinned dependencies from source, which conda does not do. Nothing in
  onionshare_cli imports them.
* stem is pinned to 1.8.1 upstream; conda-forge only has 1.8.0, which provides
  every API onionshare_cli uses.
* qrcode is capped below 8 upstream; the qrcode.QRCode and
  qrcode.image.base.BaseImage APIs used here are unchanged in 8.x.

diff --git a/pyproject.toml b/pyproject.toml
index 66b64a0..83b122c 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -27,20 +27,15 @@ requests = {extras = ["socks"], version = ">=2.32.3"}
 unidecode = "*"
 urllib3 = "^2.7"
 eventlet = "*"
-setuptools = "^80"
 pynacl = "^1.6.2"
 colorama = "*"
 gevent-websocket = "*"
-stem = "1.8.1"
+stem = ">=1.8.0"
 waitress = "^3.0.1"
 werkzeug = "3.1.8"
 packaging = ">=24"
 gevent = "^26.5.0"
-wheel = "^0.46.2"
-cffi = "^2"
-cython = "^3.0.2"
-qrcode = "^7.4.2"
-pkgconfig = "^1.6.0"
+qrcode = ">=7.4.2"
 
 [tool.poetry.group.dev.dependencies]
