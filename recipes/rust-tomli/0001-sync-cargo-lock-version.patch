From 45af3008488253120cdde926c0ad499fcf3da634 Mon Sep 17 00:00:00 2001
From: Fredrick Eisele <fred.eisele@vanderbilt.edu>
Date: Fri, 18 Sep 2026 11:35:33 -0500
Subject: [PATCH] Sync Cargo.lock with the 0.5.0 version in Cargo.toml

The 0.5.0 release bumped the version in Cargo.toml but left the tomli
entry in Cargo.lock at 0.4.0. Any cargo command that resolves the full
dependency graph, such as the cargo metadata call cargo-auditable makes,
therefore wants to rewrite the lock file and fails under --locked.
---
 Cargo.lock | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Cargo.lock b/Cargo.lock
index 0d6077f..e5fd199 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -348,7 +348,7 @@ checksum = "d163a63c116ce562a22cda521fcc4d79152e7aba014456fb5eb442f6d6a10109"
 
 [[package]]
 name = "tomli"
-version = "0.4.0"
+version = "0.5.0"
 dependencies = [
  "clap",
  "tempfile",
