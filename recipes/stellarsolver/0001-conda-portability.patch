diff --git a/CMakeLists.txt b/CMakeLists.txt
index 84ad009..ac94da1 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -37,9 +37,9 @@ configure_file(
 set(CMAKE_AUTOMOC ON)
 set(CMAKE_AUTORCC ON)
 
-if(APPLE)
+if(APPLE AND NOT DEFINED CMAKE_OSX_DEPLOYMENT_TARGET)
     set(CMAKE_OSX_DEPLOYMENT_TARGET 10.15)
-endif(APPLE)
+endif()
 
 LIST(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_SOURCE_DIR}/cmake/modules/")
 include(GNUInstallDirs)
@@ -67,6 +67,17 @@ if (WIN32)
     file(APPEND "${config_FN}" "#define NEED_QSORT_R 1\n")
     file(APPEND "${config_FN}" "#define NEED_SWAP_QSORT_R 0\n")
 
+elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
+    # conda-forge Linux uses glibc and its GNU qsort_r calling convention.
+    # The bundled os-features-test.c no longer implements the qsort probes.
+    file(APPEND "${config_FN}" "#define NEED_DECLARE_QSORT_R 0\n")
+    file(APPEND "${config_FN}" "#define NEED_QSORT_R 0\n")
+    file(APPEND "${config_FN}" "#define NEED_SWAP_QSORT_R 1\n")
+elseif(APPLE)
+    # macOS provides the BSD qsort_r calling convention.
+    file(APPEND "${config_FN}" "#define NEED_DECLARE_QSORT_R 0\n")
+    file(APPEND "${config_FN}" "#define NEED_QSORT_R 0\n")
+    file(APPEND "${config_FN}" "#define NEED_SWAP_QSORT_R 0\n")
 else(WIN32)
 
 try_run(RUN_RESULT_2 COMPILE_SUCCESS_2 ${CMAKE_CURRENT_BINARY_DIR} ${config_SRCS} COMPILE_DEFINITIONS -DTEST_DECLARE_QSORT_R=ON)
@@ -553,8 +564,8 @@ if(BUILD_CLI)
 
     if(APPLE)
         install(TARGETS CommandLineInterface
-        BUNDLE DESTINATION ${CMAKE_INSTALL_PREFIX}
-        RUNTIME DESTINATION ${CMAKE_INSTALL_PREFIX}
+        BUNDLE DESTINATION ${CMAKE_INSTALL_BINDIR}
+        RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
     )
     else(APPLE)
         #installation for Linux and Windows
