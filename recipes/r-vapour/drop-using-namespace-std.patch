From c64d8134593757f7b85beb388951896f0363a885 Mon Sep 17 00:00:00 2001
From: Matthew Feickert <matthew.feickert@cern.ch>
Date: Fri, 16 Oct 2026 13:46:16 -0600
Subject: [PATCH] Drop global `using namespace std;` from gdalwarpgeneral.h

The header pulls the whole std namespace into the global scope and then
also does `using namespace cpp11;`. With the MSVC STL, GDAL's headers
transitively include <list>, so every unqualified `list` (meant as
cpp11::list) becomes ambiguous between cpp11::list and std::list and
compilation fails. Nothing in the header relies on the directive, so
remove it.
---
 inst/include/gdalwarpgeneral/gdalwarpgeneral.h | 1 -
 1 file changed, 1 deletion(-)

diff --git a/inst/include/gdalwarpgeneral/gdalwarpgeneral.h b/inst/include/gdalwarpgeneral/gdalwarpgeneral.h
index dbf623a..4eed450 100644
--- a/inst/include/gdalwarpgeneral/gdalwarpgeneral.h
+++ b/inst/include/gdalwarpgeneral/gdalwarpgeneral.h
@@ -8,7 +8,6 @@
 #include "gdal_utils.h"
 #include "gdalraster/gdalraster.h"
 #include "ogr_spatialref.h"
-using namespace std;
 
 namespace gdalwarpgeneral{
 
