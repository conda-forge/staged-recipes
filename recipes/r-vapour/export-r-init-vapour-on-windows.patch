From 03eece81a299afc54d283223b3904f1716b161b0 Mon Sep 17 00:00:00 2001
From: Matthew Feickert <matthew.feickert@cern.ch>
Date: Mon, 9 Nov 2026 01:24:38 -0700
Subject: [PATCH] Export R_init_vapour with __declspec(dllexport) on Windows

conda-forge builds R packages on Windows with the r_clang compiler
wrapper, which drops the tmp.def export list that R generates for the
package DLL. Without it R_init_vapour is not exported and R cannot
register the package's native routines on load. Mark the init function
for export explicitly.
---
 src/cpp11.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/cpp11.cpp b/src/cpp11.cpp
index 3861ed4..e212992 100644
--- a/src/cpp11.cpp
+++ b/src/cpp11.cpp
@@ -444,7 +444,7 @@ static const R_CallMethodDef CallEntries[] = {
 };
 }
 
-extern "C" attribute_visible void R_init_vapour(DllInfo* dll){
+extern "C" __declspec(dllexport) void R_init_vapour(DllInfo* dll){
   R_registerRoutines(dll, NULL, CallEntries, NULL, NULL);
   R_useDynamicSymbols(dll, FALSE);
   R_forceSymbols(dll, TRUE);
