From 1ddaa7109a624f874c72035468cd25a74ccc3976 Mon Sep 17 00:00:00 2001
From: Matthew Feickert <matthew.feickert@cern.ch>
Date: Fri, 16 Oct 2026 12:47:00 -0600
Subject: [PATCH] Pass LDFLAGS to configure test link commands

The hand-written GDAL and PROJ test programs in configure are linked
with only CPPFLAGS and LIBS, dropping LDFLAGS. When GDAL lives in a
prefix not on the default runtime search path (e.g. conda-forge, which
supplies -Wl,-rpath,$PREFIX/lib via LDFLAGS), the test binaries then
fail to load libgdal at run time and configure errors with
"PROJ not available?".
---
 configure | 16 ++++++++--------
 1 file changed, 8 insertions(+), 8 deletions(-)

diff --git a/configure b/configure
index 3d15a7c..a46c12e 100755
--- a/configure
+++ b/configure
@@ -3526,7 +3526,7 @@ _EOCONF
 
 { printf "%s\n" "$as_me:${as_lineno-$LINENO}: checking GDAL: linking with --libs only" >&5
 printf %s "checking GDAL: linking with --libs only... " >&6; }
-${CXX} ${CPPFLAGS} -o gdal_test gdal_test.cpp ${LIBS} 2> errors.txt
+${CXX} ${CPPFLAGS} -o gdal_test gdal_test.cpp ${LDFLAGS} ${LIBS} 2> errors.txt
 if test `echo $?` -ne 0 ; then
 gdalok=no
 { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: no" >&5
@@ -3541,7 +3541,7 @@ if test "${gdalok}" = no; then
 printf %s "checking GDAL: linking with --libs and --dep-libs... " >&6; }
 LIBS="${LIBS} ${GDAL_DEP_LIBS}"
 gdalok=yes
-${CXX} ${CPPFLAGS} -o gdal_test gdal_test.cpp ${LIBS} 2>> errors.txt
+${CXX} ${CPPFLAGS} -o gdal_test gdal_test.cpp ${LDFLAGS} ${LIBS} 2>> errors.txt
 if test `echo $?` -ne 0 ; then
 gdalok=no
 fi
@@ -3652,7 +3652,7 @@ _EOCONF
 
 { printf "%s\n" "$as_me:${as_lineno-$LINENO}: checking GDAL: checking whether PROJ is available for linking:" >&5
 printf %s "checking GDAL: checking whether PROJ is available for linking:... " >&6; }
-${CXX} ${CPPFLAGS} -o gdal_proj gdal_proj.cpp ${LIBS}  2> errors.txt
+${CXX} ${CPPFLAGS} -o gdal_proj gdal_proj.cpp ${LDFLAGS} ${LIBS}  2> errors.txt
 if test `echo $?` -ne 0 ; then
 gdal_has_proj=no
 { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: no" >&5
@@ -3909,7 +3909,7 @@ printf %s "checking PROJ: checking whether PROJ and sqlite3 are available for li
   ## LDFLAGS?  CRAN says, I removed -sqlite3 which was a mistake (that's in LIBS already)
   ## have check on macbuilder that LIBS includes same pkg-config --libs proj as
   ## BDR (2022-11-15): -L/opt/R/arm64/lib -lproj -lc++ -lm -ldl -lsqlite3 -lz -lcurl -ltiff -lwebp -llzma -ljpeg -lz
-  ${CXX} ${CPPFLAGS} -o proj_conf_test proj_conf_test.cpp ${LIBS}  2> errors.txt
+  ${CXX} ${CPPFLAGS} -o proj_conf_test proj_conf_test.cpp ${LDFLAGS} ${LIBS}  2> errors.txt
   if test `echo $?` -ne 0 ; then
     proj6ok=no
     { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: no" >&5
@@ -3937,7 +3937,7 @@ fi
 
 #AC_MSG_NOTICE([PKG_LIBS: ${PKG_LIBS}])
 
-${CC} ${CFLAGS} ${CPPFLAGS} -o proj_conf_test proj_conf_test.c ${PROJ_LIBS}
+${CC} ${CFLAGS} ${CPPFLAGS} -o proj_conf_test proj_conf_test.c ${LDFLAGS} ${PROJ_LIBS}
 
 proj_version=`./proj_conf_test`
 
@@ -3981,7 +3981,7 @@ int main(void) {
 }
 _EOCONF
 
-${CC} ${CFLAGS} ${CPPFLAGS} -o proj_conf_test proj_conf_test.c ${PROJ_LIBS}
+${CC} ${CFLAGS} ${CPPFLAGS} -o proj_conf_test proj_conf_test.c ${LDFLAGS} ${PROJ_LIBS}
 if test  -n "$proj_share_path"  ; then
   PROJ_LIB="${proj_share_path}" ./proj_conf_test
   proj_share=`echo $?`
@@ -4032,7 +4032,7 @@ int main(void) {
 }
 _EOCONF
 
-${CC} ${CFLAGS} ${CPPFLAGS} -o proj_conf_test proj_conf_test.c ${PROJ_LIBS}
+${CC} ${CFLAGS} ${CPPFLAGS} -o proj_conf_test proj_conf_test.c ${LDFLAGS} ${PROJ_LIBS}
 if test  -n "$proj_share_path"  ; then
   PROJ_LIB="${proj_share_path}" ./proj_conf_test
   proj_share=`echo $?`
@@ -4088,7 +4088,7 @@ int main(void) {
 }
 _EOCONF
 
-${CC} ${CFLAGS} ${CPPFLAGS} -o proj_conf_test proj_conf_test.c ${PROJ_LIBS}
+${CC} ${CFLAGS} ${CPPFLAGS} -o proj_conf_test proj_conf_test.c ${LDFLAGS} ${PROJ_LIBS}
 if test  -n "$proj_share_path"  ; then
   PROJ_LIB="${proj_share_path}" ./proj_conf_test
   proj_share=`echo $?`
