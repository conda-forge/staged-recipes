{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://schemas.conda.io/menuinst-1.schema.json",
  "menu_name": "SolidOcean",
  "menu_items": [
    {
      "name": "SolidOcean",
      "description": "Finite element tool for 3D structures: phonons, solid mechanics and heat transfer",
      "icon": "{{ MENU_DIR }}/solidocean.{{ ICON_EXT }}",
      "command": ["{{ PYTHON }}", "-m", "solidocean", "--gui"],
      "activate": true,
      "terminal": false,
      "platforms": {
        "linux": {
          "Categories": ["Science", "Education", "Physics"],
          "StartupWMClass": "SolidOcean"
        },
        "osx": {
          "CFBundleName": "SolidOcean",
          "CFBundleDisplayName": "SolidOcean",
          "CFBundleIdentifier": "org.solidocean.SolidOcean",
          "LSMinimumSystemVersion": "11.0.0",
          "link_in_bundle": {
            "{{ PREFIX }}/bin/python": "{{ MENU_ITEM_LOCATION }}/Contents/Resources/python"
          },
          "command": ["{{ MENU_ITEM_LOCATION }}/Contents/Resources/python", "-m", "solidocean", "--gui"]
        },
        "win": {
          "command": ["{{ PYTHONW }}", "-m", "solidocean", "--gui"],
          "desktop": true
        }
      }
    }
  ]
}
