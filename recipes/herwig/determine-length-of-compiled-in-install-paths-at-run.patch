From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matthew Feickert <matthew.feickert@cern.ch>
Date: Thu, 1 Oct 2026 14:19:04 -0600
Subject: [PATCH] Determine length of compiled-in install paths at run time

The install paths HERWIG_PKGDATADIR, HERWIG_PKGLIBDIR, and THEPEG_PKGLIBDIR
are compiled into libHerwigAPI as string literals that are converted to
std::string with a length that the compiler fixes at build time.

conda relocates a package by replacing the build time install prefix inside
such literals with the (shorter) install time prefix padded with NUL bytes.
The fixed length then includes the padding, so that, e.g., the default
repository is searched for at '<prefix>/share/Herwig\0\0...\0/HerwigDefaults.rpo'
and Herwig fails with "Could not find repository".

Read the literals through a volatile pointer so that their length is
determined at run time.
---
 API/HerwigAPI.cc | 19 ++++++++++++++++---
 1 file changed, 16 insertions(+), 3 deletions(-)

diff --git a/API/HerwigAPI.cc b/API/HerwigAPI.cc
index 42ce449..03da529 100644
--- a/API/HerwigAPI.cc
+++ b/API/HerwigAPI.cc
@@ -42,6 +42,19 @@ namespace {
   void HerwigGenericRead(const Herwig::HerwigUI & ui);
   ThePEG::EGPtr HerwigGenericRun(const Herwig::HerwigUI & ui,
 				 bool prepareOnly = false);
+
+  /**
+   * Build a string from an install path compiled into the library.
+   *
+   * conda relocates a package by overwriting the install prefix inside
+   * string literals with a shorter, NUL padded one. Reading the literal
+   * through a volatile pointer makes its length be determined at run time
+   * rather than fixed to the build time length at compile time.
+   */
+  string installPath(const char * literal) {
+    const char * volatile path = literal;
+    return path;
+  }
 }
 
 namespace Herwig {
@@ -60,10 +73,10 @@ namespace Herwig {
       breakThePEG();
       {
 #   ifdef HERWIG_PKGLIBDIR
-	DynamicLoader::appendPath(HERWIG_PKGLIBDIR);
+	DynamicLoader::appendPath(installPath(HERWIG_PKGLIBDIR));
 #   endif
 #   ifdef THEPEG_PKGLIBDIR
-	DynamicLoader::appendPath(THEPEG_PKGLIBDIR);
+	DynamicLoader::appendPath(installPath(THEPEG_PKGLIBDIR));
 #   endif
 	HoldFlag<> setup(InterfaceBase::NoReadOnly);
 	string msg = Repository::read(infile, ui.outStream());
@@ -131,7 +144,7 @@ namespace {
 #ifdef HERWIG_PKGDATADIR
     ifstream test(reponame.c_str());
     if ( !test ) {
-      reponame = string(HERWIG_PKGDATADIR) + '/' + reponame;
+      reponame = installPath(HERWIG_PKGDATADIR) + '/' + reponame;
     }
     test.close();
 #endif
