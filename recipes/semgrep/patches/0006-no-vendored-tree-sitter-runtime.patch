Do not download or build the vendored tree-sitter runtime

core/dune downloads tree-sitter 0.26.3 (scripts/download-tree-sitter) and
builds it with make/cargo into tree-sitter-out. The (package tree-sitter)
install stanzas glob tree-sitter-out, so setting up _build/install forces
that network download and C build even for the semgrep-core target. conda
provides libtree-sitter (patch 0004 links against it), so drop the
download/make/cargo rules, the tree-sitter-out dep of the build alias,
and the tree-sitter install stanzas. The dune files under core/test still
reference these removed targets, so mark core/test as (data_only_dirs test):
dune then never loads them and they cannot fail the build. They are
runtest-only and not needed.

--- a/libs/ocaml-tree-sitter-semgrep/core/dune
+++ b/libs/ocaml-tree-sitter-semgrep/core/dune
@@ -1,53 +1,18 @@
+; The tree-sitter runtime comes from conda's libtree-sitter (see patch 0004);
+; nothing is downloaded or built here.
+
 (dirs :standard)

-(rule
- (mode
-  (promote (until-clean)))
- (deps
-  tree-sitter-version
-  (source_tree scripts))
- (target
-  (dir tree-sitter-repo))
- (action
-  ; Invoke via 'bash' rather than running the script directly: on Windows dune
-  ; can't CreateProcess a '#!'-script, which fails with "Exec format error".
-  (run bash %{project_root}/scripts/download-tree-sitter %{target})))
-
-(rule
- (deps tree-sitter-repo)
- (target
-  (dir tree-sitter-out))
- (action
-  (chdir
-   tree-sitter-repo
-   (progn
-    ; Note: we need absolute paths here so that the generated .pc file results
-    ; in absolute paths for pkg-config.
-    ; Keep the shared libraries (libtree-sitter.{dylib,so,dll} and their
-    ; versioned symlinks) alongside the static archive: semgrep links
-    ; tree-sitter dynamically and its packaging bundles the shared library.
-    (bash "PREFIX=$(cygpath -m $(realpath %{project_root}) 2>/dev/null || realpath %{project_root})/tree-sitter-out make")
-    (bash "PREFIX=$(cygpath -m $(realpath %{project_root}) 2>/dev/null || realpath %{project_root})/tree-sitter-out make install")))))
-
-(rule
- (deps tree-sitter-repo)
- (target tree-sitter)
- (action
-  (chdir
-   tree-sitter-repo
-   ; Don't infer deps/targets since otherwise dune expects cloning the repo to
-   ; create target/release/tree-sitter
-   (no-infer
-    (progn
-     (run cargo build --release)
-     (copy target/release/tree-sitter ../tree-sitter))))))
+; core/test dune files reference the removed tree-sitter-out/tree-sitter
+; targets; they are runtest-only, so keep dune from loading them.

-; Main build - depends on setup
+(data_only_dirs test)
+
+; Main build

 (alias
  (name build)
  (deps
-  tree-sitter-out
   (alias_rec src/all)))

 ; Expose the code generator as a native binary at core/bin/ocaml-tree-sitter,
@@ -75,19 +40,3 @@
  (name runtest)
  (deps
   (alias build)))
-
-(install
- (section lib)
- (package tree-sitter)
- (files
-  (glob_files tree-sitter-out/lib/*)))
-
-(install
- (section lib)
- (package tree-sitter)
- (dirs tree-sitter-out/include))
-
-(install
- (section bin)
- (package tree-sitter)
- (files tree-sitter))
