From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mark Harfouche <mark.harfouche@gmail.com>
Date: Mon, 26 Oct 2026 08:47:11 -0400
Subject: [PATCH 1/2] Use conda-forge GSL and nlohmann_json, fetch googletest
 only for tests

---
 cmake/deps.cmake                    | 4 ++++
 plugin/CMakeLists.txt               | 2 +-
 tests/CMakeLists.txt                | 2 +-
 tools/ovep_bin_utils/CMakeLists.txt | 2 +-
 4 files changed, 7 insertions(+), 3 deletions(-)

diff --git a/cmake/deps.cmake b/cmake/deps.cmake
index b700476..b38b237 100644
--- a/cmake/deps.cmake
+++ b/cmake/deps.cmake
@@ -23,6 +23,7 @@ FetchContent_Declare(
   GIT_REPOSITORY  https://github.com/microsoft/GSL.git
   GIT_TAG         v4.0.0
   GIT_SHALLOW     ON
+  FIND_PACKAGE_ARGS NAMES Microsoft.GSL CONFIG
 )
 FetchContent_MakeAvailable(gsl)
 
@@ -31,10 +32,12 @@ FetchContent_Declare(
   nlohmann_json
   GIT_REPOSITORY  https://github.com/nlohmann/json.git
   GIT_TAG         v3.12.0
+  FIND_PACKAGE_ARGS 3.11 CONFIG
 )
 FetchContent_MakeAvailable(nlohmann_json)
 
 # Add googletests
+if(OVEP_PLUGIN_BUILD_TESTS)
 FetchContent_Declare(
   googletest
   GIT_REPOSITORY https://github.com/google/googletest.git
@@ -43,3 +46,4 @@ FetchContent_Declare(
 )
 set(gtest_force_shared_crt ON CACHE BOOL "" FORCE)
 FetchContent_MakeAvailable(googletest)
+endif()
diff --git a/plugin/CMakeLists.txt b/plugin/CMakeLists.txt
index db5d2ae..387861b 100644
--- a/plugin/CMakeLists.txt
+++ b/plugin/CMakeLists.txt
@@ -66,7 +66,7 @@ target_link_libraries(${TARGET_NAME} PRIVATE
     openvino::runtime
     openvino::frontend::onnx
     Microsoft.GSL::GSL
-    nlohmann_json)
+    nlohmann_json::nlohmann_json)
 
 # Set RPATH for Linux to find libraries in the same directory
 if(UNIX)
diff --git a/tests/CMakeLists.txt b/tests/CMakeLists.txt
index ad1d82f..424c151 100644
--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -47,7 +47,7 @@ target_link_libraries(
     ${TARGET_NAME}
     GTest::gmock
     onnxruntime
-    nlohmann_json)
+    nlohmann_json::nlohmann_json)
 
 if(MSVC)
     target_link_libraries(
diff --git a/tools/ovep_bin_utils/CMakeLists.txt b/tools/ovep_bin_utils/CMakeLists.txt
index 39c4e11..0d55014 100644
--- a/tools/ovep_bin_utils/CMakeLists.txt
+++ b/tools/ovep_bin_utils/CMakeLists.txt
@@ -15,7 +15,7 @@ target_include_directories(ovep_bin_utils PRIVATE
 
 # Link only nlohmann_json (no OpenVINO/ORT dependencies needed)
 target_link_libraries(ovep_bin_utils PRIVATE
-    nlohmann_json)
+    nlohmann_json::nlohmann_json)
 
 # Install to bin directory
 install(TARGETS ovep_bin_utils RUNTIME DESTINATION "$<CONFIG>/bin")
