From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mark Harfouche <mark.harfouche@gmail.com>
Date: Mon, 26 Oct 2026 08:52:59 -0400
Subject: [PATCH 2/2] Add OVEP_PLUGIN_BUNDLE_RUNTIME to skip bundling the
 OpenVINO and ONNX Runtime libraries

---
 CMakeLists.txt        | 12 +++++++++---
 cmake/openvino.cmake  |  4 ++++
 plugin/CMakeLists.txt |  2 +-
 3 files changed, 14 insertions(+), 4 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 2227561..6c50218 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -36,7 +36,11 @@ endif()
 
 include(cmake/onnxruntime.cmake)
 
-if(WIN32)
+# Copy the OpenVINO, TBB and ONNX Runtime libraries next to the plugin (and embed SxS
+# manifests on Windows). Turn off when those libraries are provided by a package manager.
+option(OVEP_PLUGIN_BUNDLE_RUNTIME "Bundle the OpenVINO, TBB and ONNX Runtime libraries with the plugin" ON)
+
+if(WIN32 AND OVEP_PLUGIN_BUNDLE_RUNTIME)
   # Locate a tool in the newest available Windows SDK x64 bin directory.
   # Usage: ovep_find_winsdk_tool(<cache_var> <exe_name>)
   function(ovep_find_winsdk_tool out_var exe_name)
@@ -137,8 +141,10 @@ if(WIN32)
   add_compile_definitions(NOMINMAX)
 endif()
 
-include(cmake/openvino_install.cmake)
-include(cmake/onnxruntime_install.cmake)
+if(OVEP_PLUGIN_BUNDLE_RUNTIME)
+  include(cmake/openvino_install.cmake)
+  include(cmake/onnxruntime_install.cmake)
+endif()
 
 add_subdirectory(plugin)
 
diff --git a/cmake/openvino.cmake b/cmake/openvino.cmake
index f4e70b5..a1b228a 100644
--- a/cmake/openvino.cmake
+++ b/cmake/openvino.cmake
@@ -34,6 +34,10 @@ endif()
 find_package(OpenVINO 2026.4 REQUIRED COMPONENTS Runtime ONNX)
 message(STATUS "Found OpenVINO: ${OpenVINO_VERSION}")
 
+if(NOT OVEP_PLUGIN_BUNDLE_RUNTIME)
+  return()
+endif()
+
 # ---------------------------------------------------------------------------
 # Enumerate OV and TBB binaries for install and SxS manifest embedding.
 #
diff --git a/plugin/CMakeLists.txt b/plugin/CMakeLists.txt
index 387861b..13246c8 100644
--- a/plugin/CMakeLists.txt
+++ b/plugin/CMakeLists.txt
@@ -83,7 +83,7 @@ endif()
 
 install(TARGETS ${TARGET_NAME} RUNTIME DESTINATION "$<CONFIG>/bin" LIBRARY DESTINATION "$<CONFIG>/lib")
 
-if(WIN32)
+if(WIN32 AND OVEP_PLUGIN_BUNDLE_RUNTIME)
   # Pre-generate the SxS dep manifest for this DLL at configure time.
   set(_manifest_dir "${CMAKE_BINARY_DIR}/sxs_manifests")
   file(MAKE_DIRECTORY "${_manifest_dir}")
