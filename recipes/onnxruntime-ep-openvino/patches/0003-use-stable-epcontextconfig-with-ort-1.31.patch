From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mark Harfouche <mark.harfouche@gmail.com>
Date: Mon, 26 Oct 2026 09:55:31 -0400
Subject: [PATCH] Use Ort::EpContextConfig with ONNX Runtime 1.31 headers

---
 plugin/ov_factory.cc | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/plugin/ov_factory.cc b/plugin/ov_factory.cc
index f037313..4e708a8 100644
--- a/plugin/ov_factory.cc
+++ b/plugin/ov_factory.cc
@@ -468,9 +468,16 @@ OrtStatus* OpenVINOEpPluginFactory::CreateEp(const OrtHardwareDevice* const* dev
   // Create a new OpenVINO execution provider with this factory's device type
   auto ov_ep = std::make_unique<OpenVINOEpPlugin>(ep_name_, std::move(options), *logger, ov_device, ov_core_, onnx_fe_manager_, memory_infos);
 
+#if ORT_API_VERSION >= 31
+  // ONNX Runtime 1.31 moved EpContextConfig out of the experimental API.
+  OrtVersionGate<31>(ov_ep.get(), [&](auto ov_ep) {
+    try {
+      Ort::EpContextConfig cfg{Ort::ConstSessionOptions{session_options}};
+#else
   OrtVersionGate<28>(ov_ep.get(), [&](auto ov_ep) {
     try {
       Ort::Experimental::EpContextConfig cfg{Ort::ConstSessionOptions{session_options}};
+#endif
       OrtWriteNamedBufferFunc write_fn = nullptr;
       void* write_state = nullptr;
       cfg.GetWriteFunc(write_fn, write_state);
