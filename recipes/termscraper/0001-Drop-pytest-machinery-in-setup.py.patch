From 92aba05aa0d21356df72ffee889fa1fd85191fde Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Julian=20R=C3=BCth?= <julian.rueth@fsfe.org>
Date: Sat, 21 Nov 2026 23:33:27 -0600
Subject: [PATCH] Drop pytest machinery in setup.py

test_require was removed in https://github.com/pypa/setuptools/pull/4458.

pytest still gets installed through the requirements_dev.txt.
---
 setup.py | 2 --
 1 file changed, 2 deletions(-)

diff --git a/setup.py b/setup.py
index a67babf..fd99520 100644
--- a/setup.py
+++ b/setup.py
@@ -73,8 +73,6 @@ setup(
 
     python_requires='>=3.6',
     install_requires=install_deps,
-    setup_requires=["pytest-runner"],
-    tests_require=["pytest"],
     platforms=["any"],
 
     keywords=["scraper", "pyte", "vt102", "vte", "terminal emulator"],
-- 
2.56.1

