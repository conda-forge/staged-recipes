From: hmaarrfk <mark.harfouche@conda-forge.org>
Subject: npu_compiler: unity-build the vpux_compiler libraries

Most of the build time of vpux_compiler is spent instantiating the
templates in the generated MLIR op/pass code, which neither precompiled
headers nor lower -O levels reduce. Compiling the sources in unity
batches of 8 shares those instantiations and cuts the CPU time of
src/vpux_compiler/src from ~2.7 h to well under 1 h (clang 21), which is
what lets the conda-forge build fit in a 6 h, 2-core CI job.

Sources that clash when merged (file-local helpers with the same name,
duplicate tablegen includes, ...) are listed in
cmake/unity_build_exclusions.cmake and compiled on their own.

--- a/src/vpux_compiler/CMakeLists.txt
+++ b/src/vpux_compiler/CMakeLists.txt
@@ -113,8 +113,22 @@
 )
 
 # Construct source files after BITCOMPACTOR configuration
+set(CMAKE_UNITY_BUILD ON)
+set(CMAKE_UNITY_BUILD_BATCH_SIZE 8)
 add_subdirectory(src)
 get_property(VPU_SRC_LIBS GLOBAL PROPERTY NPU_SRC_LIB_LIST)
+include(${CMAKE_CURRENT_SOURCE_DIR}/../../cmake/unity_build_exclusions.cmake)
+list(TRANSFORM NPU_UNITY_BUILD_EXCLUSIONS PREPEND ${CMAKE_CURRENT_SOURCE_DIR}/../../)
+set(_npu_unity_targets)
+foreach(_lib IN LISTS VPU_SRC_LIBS)
+    string(REGEX REPLACE "^\\$<BUILD_INTERFACE:(.*)>$" "\\1" _lib "${_lib}")
+    if(TARGET ${_lib})
+        list(APPEND _npu_unity_targets ${_lib})
+    endif()
+endforeach()
+set_source_files_properties(${NPU_UNITY_BUILD_EXCLUSIONS}
+    TARGET_DIRECTORY ${_npu_unity_targets}
+    PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON)
 
 add_library(mlir-dependencies INTERFACE)
 
