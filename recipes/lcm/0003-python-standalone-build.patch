 # FindPython added in 3.12
 cmake_minimum_required(VERSION 3.12)
 
+# conda-forge: allow building the Python bindings on their own against an
+# installed lcm (find_package(lcm)), instead of as part of the whole project.
+if(CMAKE_SOURCE_DIR STREQUAL CMAKE_CURRENT_SOURCE_DIR)
+  project(lcm-python C)
+  find_package(lcm REQUIRED)
+  include(${CMAKE_CURRENT_SOURCE_DIR}/../lcm-cmake/functions.cmake)
+  if(WIN32)
+    find_package(Python REQUIRED COMPONENTS Interpreter Development)
+  else()
+    find_package(Python REQUIRED COMPONENTS Interpreter)
+  endif()
+endif()
+
 option(LCM_PIP_BUILD "When true, adjusts install path to something appropriate for a Python wheel" OFF)
 
 if (NOT LCM_PIP_BUILD)
