--- a/lcm/CMakeLists.txt
+++ b/lcm/CMakeLists.txt
@@ -46,10 +46,12 @@
 set(CMAKE_POSITION_INDEPENDENT_CODE ON)
 
 add_library(lcm-coretypes INTERFACE)
-add_library(lcm-static STATIC ${lcm_sources})
+# conda-forge: only build the shared library; lcm-static is an alias of it so
+# that in-tree consumers (tools, Python bindings) link the shared library.
 add_library(lcm SHARED ${lcm_sources})
+add_library(lcm-static ALIAS lcm)
 
-foreach(lcm_lib lcm lcm-static)
+foreach(lcm_lib lcm)
   target_compile_definitions(${lcm_lib} PRIVATE
     _FILE_OFFSET_BITS=64
     _LARGEFILE_SOURCE
@@ -79,16 +81,11 @@
 
 generate_export_header(lcm STATIC_DEFINE LCM_STATIC)
 
-target_compile_definitions(lcm-static PUBLIC LCM_STATIC)
-if(NOT WIN32)
-  set_target_properties(lcm-static PROPERTIES OUTPUT_NAME lcm)
-endif()
-
 target_include_directories(lcm-coretypes INTERFACE
   $<BUILD_INTERFACE:${lcm_SOURCE_DIR}>
 )
 
-install(TARGETS lcm-coretypes lcm-static lcm
+install(TARGETS lcm-coretypes lcm
   EXPORT lcmTargets
   RUNTIME DESTINATION bin
   LIBRARY DESTINATION lib${LIB_SUFFIX}
--- a/lcm-cmake/lcmConfig.cmake.in
+++ b/lcm-cmake/lcmConfig.cmake.in
@@ -4,4 +4,12 @@
 @LCM_USE_GLIB_RUNTIME@
 
 include(${CMAKE_CURRENT_LIST_DIR}/lcmTargets.cmake)
+
+# conda-forge: no static library is shipped; provide lcm-static as an alias of
+# the shared library so that existing consumers (e.g. lcm_add_library) work.
+if(NOT TARGET ${LCM_NAMESPACE}lcm-static)
+  add_library(${LCM_NAMESPACE}lcm-static INTERFACE IMPORTED)
+  set_target_properties(${LCM_NAMESPACE}lcm-static PROPERTIES
+    INTERFACE_LINK_LIBRARIES ${LCM_NAMESPACE}lcm)
+endif()
 @LCM_INCLUDE_JAVA@
