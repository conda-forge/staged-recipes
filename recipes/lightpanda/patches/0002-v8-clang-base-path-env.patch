--- a/build.zig
+++ b/build.zig
@@ -40,6 +40,15 @@
         // Use modern siso instead of outdated ninja to speed up the build.
         try args.appendSlice(gpa, "use_siso=true\n");
 
+        // conda-forge: build v8 with the environment's clang (clangdev) instead
+        // of the chromium-bundled toolchain under third_party/llvm-build, which
+        // is a prebuilt binary that cannot run on every CI image. Set
+        // V8_CLANG_BASE_PATH to the prefix containing bin/clang.
+        if (std.posix.getenv("V8_CLANG_BASE_PATH")) |clang_base_path| {
+            try args.appendSlice(gpa, b.fmt("clang_base_path = \"{s}\"\n", .{clang_base_path}));
+            try args.appendSlice(gpa, "clang_use_chrome_plugins = false\n");
+            try args.appendSlice(gpa, "treat_warnings_as_errors = false\n");
+        }
+
         // official builds depend on pgo
         try args.appendSlice(gpa, "is_official_build=false\n");
