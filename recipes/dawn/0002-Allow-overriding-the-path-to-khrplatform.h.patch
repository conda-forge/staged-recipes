Allow overriding the path to khrplatform.h

Dawn only finds KHR/khrplatform.h through DAWN_EGL_REGISTRY_DIR, which must
have the layout of an EGL-Registry checkout. Add
DAWN_KHRONOS_PLATFORM_INCLUDE_DIR, defaulting to the same path, so a build can
use the system EGL headers (libegl-devel on conda-forge), which Dawn already
includes EGL/egl.h from.

Not upstream.

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 3f89ef7d4..899142dd0 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -201,6 +201,7 @@ set_if_not_defined(DAWN_EMDAWNWEBGPU_DIR "${DAWN_THIRD_PARTY_DIR}/emdawnwebgpu"
 set_if_not_defined(DAWN_GOOGLETEST_DIR "${DAWN_THIRD_PARTY_DIR}/googletest/src" "Directory in which to find googletest")
 set_if_not_defined(DAWN_EGL_REGISTRY_DIR "${DAWN_THIRD_PARTY_DIR}/EGL-Registry/src" "Directory in which to find EGL-Registry")
 set_if_not_defined(DAWN_OPENGL_REGISTRY_DIR "${DAWN_THIRD_PARTY_DIR}/OpenGL-Registry/src" "Directory in which to find OpenGL-Registry")
+set_if_not_defined(DAWN_KHRONOS_PLATFORM_INCLUDE_DIR "${DAWN_EGL_REGISTRY_DIR}/api" "Directory in which to find KHR/khrplatform.h")
 set_if_not_defined(DAWN_SPIRV_TOOLS_DIR "${DAWN_THIRD_PARTY_DIR}/spirv-tools/src" "Directory in which to find SPIRV-Tools")
 set_if_not_defined(DAWN_SPIRV_HEADERS_DIR "${DAWN_THIRD_PARTY_DIR}/spirv-headers/src" "Directory in which to find SPIRV-Headers")
 set_if_not_defined(DAWN_GLSLANG_DIR "${DAWN_THIRD_PARTY_DIR}/glslang/src" "Directory in which to find GLSLang")
diff --git a/third_party/CMakeLists.txt b/third_party/CMakeLists.txt
