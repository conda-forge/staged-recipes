# CMake package for the header-only MCAP C++ library.
#
# Provides the INTERFACE target mcap::mcap (C++17), which links lz4 and zstd.
# Define MCAP_IMPLEMENTATION in exactly one translation unit before including
# <mcap/mcap.hpp> (see the upstream README).

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(NOT TARGET mcap::mcap)
  # zstd ships a CMake package (zstd::libzstd).
  find_dependency(zstd CONFIG)

  # lz4 (lz4-c) does not ship a CMake package; look it up next to this one.
  find_path(MCAP_LZ4_INCLUDE_DIR lz4frame.h
    HINTS "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
  find_library(MCAP_LZ4_LIBRARY NAMES lz4 liblz4
    HINTS "@PACKAGE_CMAKE_INSTALL_LIBDIR@")
  if(NOT MCAP_LZ4_INCLUDE_DIR OR NOT MCAP_LZ4_LIBRARY)
    set(mcap_FOUND FALSE)
    set(mcap_NOT_FOUND_MESSAGE "lz4 (lz4frame.h / liblz4) not found")
    return()
  endif()

  add_library(mcap::mcap INTERFACE IMPORTED)
  set_target_properties(mcap::mcap PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@;${MCAP_LZ4_INCLUDE_DIR}"
    INTERFACE_COMPILE_FEATURES cxx_std_17
    INTERFACE_LINK_LIBRARIES "zstd::libzstd;${MCAP_LZ4_LIBRARY}")
endif()

check_required_components(mcap)
