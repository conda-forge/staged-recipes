From cc8f02e7af7a690f32a234075571f23ab40076c3 Mon Sep 17 00:00:00 2001
From: Chris Burr <christopher.burr@cern.ch>
Date: Tue, 15 Sep 2026 20:06:12 +0200
Subject: [PATCH] BUILD: Make the prebuilt eos-tui download optional

EosTui fetches an eos-tui binary from storage-ci.web.cern.ch during
`make install`, which fails in any build environment without outbound
network access, and pulls in a binary that some distributors cannot
redistribute. EOS_INSTALL_TUI=OFF skips it; the default is unchanged.
---
 CMakeLists.txt | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 326a671ce..7d7bc8a5a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -195,8 +195,12 @@ set(EOS_PACKAGE_RELEASE "${RELEASE}")
 set(EOS_SOURCE_PACKAGE_NAME "${EOS_PACKAGE_NAME}-${EOS_PACKAGE_VERSION}-${EOS_PACKAGE_RELEASE}")
 set(EOS_ARCHIVE "${EOS_SOURCE_PACKAGE_NAME}.tar.gz")
 set(EOS_ARCHIVE_PATH "${CMAKE_BINARY_DIR}/${EOS_ARCHIVE}")
-set(EOS_TUI_VERSION "0.2.14")
-include(EosTui)
+option(EOS_INSTALL_TUI "Download and install the prebuilt eos-tui binary" ON)
+
+if (EOS_INSTALL_TUI)
+  set(EOS_TUI_VERSION "0.2.14")
+  include(EosTui)
+endif()
 
 configure_file(
   "${CMAKE_CURRENT_SOURCE_DIR}/cmake/config_spec.cmake.in"
