From 21ff18394c77edbb96151401cfa867dfb5eda61d Mon Sep 17 00:00:00 2001
From: Chris Burr <christopher.burr@cern.ch>
Date: Fri, 18 Sep 2026 07:14:46 +0200
Subject: [PATCH 10/12] COMMON: Allow building against a system jwt-cpp

The vendored submodule is put on the include path unconditionally. Every
consumer already includes it as "jwt-cpp/jwt.h", which is the installed
layout, so a system copy needs no source changes -- only the include
directory has to come from somewhere else.

USE_SYSTEM_JWT_CPP selects find_package(jwt-cpp) instead, mirroring the
existing USE_SYSTEM_GTEST option. The default is unchanged.
---
 common/CMakeLists.txt | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/common/CMakeLists.txt b/common/CMakeLists.txt
index 814dd884e..831bcafad 100644
--- a/common/CMakeLists.txt
+++ b/common/CMakeLists.txt
@@ -21,9 +21,19 @@
 # * along with this program.  If not, see <http://www.gnu.org/licenses/>.*
 # ************************************************************************
 
+option(USE_SYSTEM_JWT_CPP "Use jwt-cpp installed in the system if found" OFF)
+
+if(USE_SYSTEM_JWT_CPP)
+  find_package(jwt-cpp REQUIRED)
+  get_target_property(JWT_CPP_INCLUDE_DIRS jwt-cpp::jwt-cpp
+    INTERFACE_INCLUDE_DIRECTORIES)
+else()
+  set(JWT_CPP_INCLUDE_DIRS ${CMAKE_SOURCE_DIR}/common/jwt-cpp/include)
+endif()
+
 include_directories(
   ${CMAKE_BINARY_DIR}
-  ${CMAKE_SOURCE_DIR}/common/jwt-cpp/include/)
+  ${JWT_CPP_INCLUDE_DIRS})
 
 #-------------------------------------------------------------------------------
 # CLI11 parser submodule (console/parser)
