From: conda-forge
Subject: Use the dynamic MSVC runtime for conda builds

The published wheels statically link the MSVC runtime so a single wheel
can be installed on machines without the Visual C++ redistributable.
Conda-forge packages instead use the shared runtime provided by the
vc/vs runtime packages.

--- a/pyproject.toml
+++ b/pyproject.toml
@@ -84,8 +84,7 @@
 
 [tool.scikit-build.cmake.define]
 DTMB_CORE_BUILD_TESTS = "OFF"
-DTMB_CORE_ENABLE_CUDA_LDPC = "OFF"
-DTMB_CORE_ENABLE_FFTW = "OFF"
-CMAKE_MSVC_RUNTIME_LIBRARY = "MultiThreaded"
+DTMB_CORE_ENABLE_CUDA_LDPC = "OFF"
+DTMB_CORE_ENABLE_FFTW = "OFF"
 
 [tool.pytest.ini_options]
