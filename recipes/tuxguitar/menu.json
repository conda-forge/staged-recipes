{
  "$schema": "https://schemas.conda.org/menuinst/menuinst-1-1-0.schema.json",
  "menu_name": "TuxGuitar",
  "menu_items": [
    {
      "name": "TuxGuitar",
      "description": "Multitrack guitar tablature editor and player",
      "icon": "{{ MENU_DIR }}/tuxguitar.{{ ICON_EXT }}",
      "command": ["{{ PREFIX }}/bin/tuxguitar"],
      "platforms": {
        "linux": {
          "Categories": ["AudioVideo", "Audio"],
          "GenericName": "Guitar Tablature Editor"
        },
        "osx": {
          "CFBundleName": "TuxGuitar"
        },
        "win": {
          "command": ["{{ PREFIX }}/opt/tuxguitar/tuxguitar.exe"]
        }
      }
    }
  ]
}
