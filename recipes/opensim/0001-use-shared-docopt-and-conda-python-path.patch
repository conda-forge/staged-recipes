+        # For standalone builds, copy dependency DLLs into OpenSim's build
+        # directory so that they are available while running tests.
+        add_dependencies(osimCommon Copy_Simbody_DLLs)
+        if(WITH_EZC3D)
+            add_dependencies(osimCommon Copy_ezc3d_DLLs)
+        endif()
     endif()
 endif()
   
