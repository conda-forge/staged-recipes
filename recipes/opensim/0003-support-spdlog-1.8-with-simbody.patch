diff --git a/OpenSim/Common/Logger.h b/OpenSim/Common/Logger.h
--- a/OpenSim/Common/Logger.h
+++ b/OpenSim/Common/Logger.h
@@ -29,6 +29,22 @@
 #include <string>
 #include <spdlog/fmt/ostr.h> 
 
+// Simbody 3.7 provides an unconstrained operator<= template in namespace
+// SimTK. When a translation unit imports that namespace, it can intercept
+// fmt 7's internal size comparison and prevent constant evaluation. Prefer
+// the built-in comparison for the exact fmt enum used by spdlog 1.8.
+#if FMT_VERSION >= 70000 && FMT_VERSION < 80000
+namespace fmt {
+inline namespace v7 {
+namespace detail {
+constexpr bool operator<=(std::size_t lhs, decltype(max_packed_args) rhs) {
+    return lhs <= static_cast<std::size_t>(rhs);
+}
+} // namespace detail
+} // namespace v7
+} // namespace fmt
+#endif
+
 namespace OpenSim {
 
 class LogSink;
