 namespace OpenSim {
 
+// Not intended for end users.
+namespace detail {
+// Backwards-compatibility hack: the original implementation allows for
+// references to booleans, which won't work with std::vector<bool>.
+// Keep this outside the Array template so MSVC 17.14 emits its inline methods
+// in each consumer instead of looking for unexported nested-class symbols.
+class BoolLike final {
+public:
+    BoolLike(bool value_) : value{value_} {}
+    operator bool& () { return value; }
+    operator const bool& () const { return value; }
+private:
+    bool value;
+};
+} // namespace detail
