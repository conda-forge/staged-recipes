From 8e430ff87dacc599828695ad7f704d5915fea4ed Mon Sep 17 00:00:00 2001
From: Pavel Zwerschke <pavel.zwerschke@quantco.com>
Date: Wed, 4 Nov 2026 12:04:56 +0100
Subject: [PATCH] Link against system liblzfse instead of vendored sources

conda-forge ships liblzfse as a separate package. Link the extension
against it instead of compiling the vendored copy of the reference
implementation.
---
 pyproject.toml |  2 +-
 setup.py       | 12 ++----------
 2 files changed, 3 insertions(+), 11 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index 525e046..e094e0c 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -17,7 +17,7 @@ maintainers = [
 "Bug Tracker" = "https://github.com/m1stadev/lzfse/issues"
 
 [tool.setuptools]
-packages = ["lzfse"]
+packages = []
 
 [tool.ruff]
 target-version = "py38"
diff --git a/setup.py b/setup.py
index 0eefff5..d0cbbe1 100644
--- a/setup.py
+++ b/setup.py
@@ -22,22 +22,14 @@
 # SOFTWARE.
 
 
-from pathlib import Path
-
 from setuptools import Extension, setup
 
-lzfse_src_path = Path('lzfse/src')
-lzfse_src = [
-    *[str(f) for f in lzfse_src_path.glob('*.c') if f != 'lzfse/src/lzfse_main.c'],
-    'pylzfse.c',
-]
-
 setup(
     ext_modules=[
         Extension(
             'lzfse',
-            sources=lzfse_src,
-            include_dirs=[str(lzfse_src_path)],
+            sources=['pylzfse.c'],
+            libraries=['lzfse'],
         )
     ]
 )
