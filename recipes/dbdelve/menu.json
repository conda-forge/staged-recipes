{
  "$schema": "https://schemas.conda.org/menuinst/menuinst-1-1-0.schema.json",
  "menu_name": "DBDelve",
  "menu_items": [
    {
      "name": "DBDelve",
      "description": "A native SQL client",
      "icon": "{{ MENU_DIR }}/dbdelve.{{ ICON_EXT }}",
      "command": ["{{ BIN_DIR }}/dbdelve"],
      "platforms": {
        "osx": {
          "CFBundleIdentifier": "com.shayanabbas.dbdelve",
          "CFBundleVersion": "__PKG_VERSION__",
          "info_plist_extra": {
            "NSHighResolutionCapable": true
          }
        },
        "linux": {
          "Categories": ["Development", "Database"],
          "GenericName": "SQL Client",
          "StartupNotify": true,
          "StartupWMClass": "dbdelve"
        },
        "win": {
          "desktop": true
        }
      }
    }
  ]
}
