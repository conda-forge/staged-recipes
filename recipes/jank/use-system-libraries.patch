-  INPUT_PREFIX "${CMAKE_SOURCE_DIR}/third-party/folly/"
-  OUTPUT_PREFIX "include/"
-  PATTERN "${CMAKE_SOURCE_DIR}/third-party/folly/folly/*.h"
