From: conda-forge maintainers
Subject: [PATCH] Use packaged Boost, Folly, cpptrace and JSON

Keep the patched BDWGC and LLVM 23 CppInterOp sources. External library
headers remain owned by their runtime packages; explicitly link shared
dependencies when consuming jank's merged runtime archive.

--- a/compiler+runtime/CMakeLists.txt
+++ b/compiler+runtime/CMakeLists.txt
@@ -105,6 +105,8 @@
 set(
   jank_common_compiler_flags
   -std=gnu++20
+  # Folly headers include glog during both native and embedded JIT compilation.
+  -DGLOG_USE_GLOG_EXPORT
   -DJANK_VERSION="${jank_version}"
   -DJANK_CMAKE_BUILD_TYPE="${CMAKE_BUILD_TYPE}"
   # https://groups.google.com/g/llvm-dev/c/W-OweiAjDcU?pli=1
@@ -440,11 +442,10 @@
   jank_lib_phase_2
   jank_static_lib
   cpptrace::cpptrace
-  Boost::multiprecision
   nanobench_lib
   jankzip_lib
   bdwgc::gc bdwgc::gctba
-  folly_lib
+  Folly::folly
   clangCppInterOp
 )
 
@@ -491,10 +492,11 @@
 
 include(FetchContent)
 include(cmake/dependency/bdwgc.cmake)
-include(cmake/dependency/cpptrace.cmake)
+find_package(cpptrace 1.0.4 CONFIG REQUIRED)
 include(cmake/dependency/cppinterop.cmake)
-include(cmake/dependency/boost-multiprecision.cmake)
-include(cmake/dependency/folly.cmake)
+
+find_package(folly CONFIG REQUIRED)
+find_package(nlohmann_json 3.12 CONFIG REQUIRED)
 include(cmake/dependency/isocline.cmake)
 
 if(jank_test)
@@ -652,18 +654,12 @@
   SYSTEM
   PUBLIC
   "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/third-party/nanobench/include>"
-  "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/third-party/folly>"
   "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/third-party/bdwgc/include>"
   "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/third-party/immer>"
   "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/third-party/zip/src>"
-  "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/third-party/cpptrace/include>"
   "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/third-party/cppinterop/include>"
   "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/third-party/cppinterop/lib>"
-  "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/third-party/boost-preprocessor/include>"
-  "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/third-party/boost-multiprecision/include>"
-  "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/third-party/boost-process/include>"
   "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/third-party/stduuid/include/>"
-  "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/third-party/json/include>"
   "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/third-party/isocline/include>"
   ${Boost_INCLUDE_DIRS}
 )
@@ -671,8 +667,9 @@
 target_link_libraries(
   jank_common_lib PRIVATE
   cpptrace::cpptrace
-  Boost::multiprecision
-  Boost::boost
+  Boost::headers
+  Folly::folly
+  nlohmann_json::nlohmann_json
   nanobench_lib
   bdwgc::gc bdwgc::gctba
 )
@@ -703,6 +700,7 @@
   endif()
 endforeach()
 
+list(APPEND jank_linker_flags -lfolly -lcpptrace)
 set(jank_lib_linker_flags_list "")
 
 get_target_property(jank_lib_link_dirs_prop jank_common_lib LINK_DIRECTORIES)
@@ -910,6 +908,7 @@
   jank_exe_phase_1 PUBLIC
   ${jank_link_whole_start} ${CMAKE_BINARY_DIR}/libjank-dynamic-runtime-phase-1.a ${jank_link_whole_end}
   LLVM clang-cpp
+  Folly::folly cpptrace::cpptrace
   isocline
   ZLIB::ZLIB
 )
--- a/compiler+runtime/cmake/install.cmake
+++ b/compiler+runtime/cmake/install.cmake
@@ -60,27 +60,10 @@
   PATTERN "${CMAKE_SOURCE_DIR}/third-party/nanobench/include/*"
 )
 
-# TODO: Trim this WAY down to only what we use.
