#!/usr/bin/env bash
# Run the centres command-line program (CIP stereo labelling).
# The jar is found relative to this script, so the environment works from any folder.
# Extra Java options can be set with JAVA_OPTS, for example JAVA_OPTS="-Xmx2g".
prefix="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC2086
exec java ${JAVA_OPTS:-} -jar "${prefix}/share/centres/centres.jar" "$@"
