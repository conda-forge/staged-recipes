conda-forge path adjustments for a plain (non wheel-builder) install.

Resolve the vendored apps/ and scripts/ dirs from $PREFIX/share/isaaclab
instead of the interpreter lib root. Upstream computes these paths four
parents up from the source checkout, which for a plain install lands them
in $PREFIX/lib as unqualified apps/ and scripts/ dirs. Point ISAACLAB_ROOT
and the kit experience path at $PREFIX/share/isaaclab so the recipe can
vendor them there and keep the prefix clean.

diff --git a/source/isaaclab/isaaclab/cli/utils.py b/source/isaaclab/isaaclab/cli/utils.py
index ced6877..1f5d3d8 100644
--- a/source/isaaclab/isaaclab/cli/utils.py
+++ b/source/isaaclab/isaaclab/cli/utils.py
@@ -13,7 +13,7 @@ from pathlib import Path
 from typing import IO, Any
 
 # Path to Isaac Lab installation.
-ISAACLAB_ROOT = Path(__file__).parents[4].resolve()
+ISAACLAB_ROOT = Path(__file__).parents[5].resolve() / "share" / "isaaclab"
 
 # Default path to look for Isaac Sim is _isaac_sim symlink.
 DEFAULT_ISAAC_SIM_PATH = ISAACLAB_ROOT / "_isaac_sim"
diff --git a/source/isaaclab/isaaclab/utils/assets.py b/source/isaaclab/isaaclab/utils/assets.py
index ee4e02e..67dfa06 100644
--- a/source/isaaclab/isaaclab/utils/assets.py
+++ b/source/isaaclab/isaaclab/utils/assets.py
@@ -42,7 +42,7 @@ _MDL_RELATIVE_IMPORT_RE = re.compile(
 
 
 _KIT_EXPERIENCE_PATH = os.path.normpath(
-    os.path.join(os.path.dirname(__file__), *([".."] * 4), "apps", "isaaclab.python.kit")
+    os.path.join(os.path.dirname(__file__), *([".."] * 5), "share", "isaaclab", "apps", "isaaclab.python.kit")
 )
 
 # Isaac Sim resolves ``persistent.isaac.asset_root.default``, so it is read first. The
