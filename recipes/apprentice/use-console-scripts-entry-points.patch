diff -Nur a2/apprentice/_cli.py b2/apprentice/_cli.py
--- a2/apprentice/_cli.py	1969-12-31 18:00:00.000000000 -0600
+++ b2/apprentice/_cli.py	2026-09-17 00:43:26.945505974 -0500
@@ -0,0 +1,27 @@
+"""console_scripts entry points for the apprentice command line scripts.
+
+The scripts execute at module level and so are not importable functions.
+Run them unmodified with runpy as __main__ instead.
+"""
+import os
+import runpy
+
+_PACKAGE_DIR = os.path.dirname(os.path.abspath(__file__))
+
+
+def _runner(name, subdir="scripts"):
+    def run():
+        runpy.run_path(os.path.join(_PACKAGE_DIR, subdir, name), run_name="__main__")
+
+    return run
+
+
+app_ls = _runner("app-ls")
+app_tune2 = _runner("app-tune2")
+app_build = _runner("app-build")
+app_predict = _runner("app-predict")
+app_datadirtojson = _runner("app-datadirtojson")
+app_yoda2h5 = _runner("app-yoda2h5")
+app_yodaenvelope = _runner("app-yodaenvelope")
+app_sample = _runner("app-sample")
+extrema = _runner("extrema.py", subdir="etc")
