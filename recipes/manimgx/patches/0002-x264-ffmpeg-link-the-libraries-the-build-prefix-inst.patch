-            for word in text.split(|c: char| !(c.is_ascii_alphanumeric() || c == '_' || c == '#')).filter(|w| !w.is_empty()) {
-                let configured = ["HAVE_", "CONFIG_", "ARCH_"].iter().any(|p| word.len() > p.len() && word.starts_with(p))
