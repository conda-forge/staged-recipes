-                if configured {
-                    if previous == "#define" || previous == "define" { defined.insert(word.to_owned()) } else { tested.insert(word.to_owned()) };
-                }
-                previous = word;
-            }
-        }
+/// The host prefix's include and library folders: conda-build's PREFIX (its Library\ on Windows).
+fn prefix() -> (PathBuf, PathBuf) {
+    let prefix = std::env::var_os("PREFIX").or_else(|| std::env::var_os("CONDA_PREFIX")).expect("PREFIX: the conda host prefix");
+    let mut prefix = PathBuf::from(prefix);
+    if std::env::var("CARGO_CFG_TARGET_OS").as_deref() == Ok("windows") {
+        prefix.push("Library");
     }
-}
