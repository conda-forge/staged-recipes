+++ b/CppCore/rgpot/frontend_api.hpp
@@ -0,0 +1,19 @@
+#pragma once
+// MIT License
+// Copyright 2023--present rgpot developers
+
+// Package consumers on Windows link the import library. The objects
+// that define these classes are built with RGPOT_FRONTEND_EXPORT.
+// A target that links those objects directly defines
+// RGPOT_FRONTEND_STATIC and calls the symbols rather than import
+// thunks. Other platforms leave the macro empty.
+
+#if defined(_WIN32) && !defined(RGPOT_FRONTEND_STATIC)
+#if defined(RGPOT_FRONTEND_EXPORT)
+#define RGPOT_FRONTEND_API __declspec(dllexport)
+#else
+#define RGPOT_FRONTEND_API __declspec(dllimport)
+#endif
+#else
+#define RGPOT_FRONTEND_API
+#endif
