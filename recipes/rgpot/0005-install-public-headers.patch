+    # The public files are the headers.
+    _header_py = find_program('python3', 'python')
+    _public_headers = run_command(
+        _header_py,
+        '-c',
+        '''
+import pathlib, sys
+root = pathlib.Path(sys.argv[1])
+for path in sorted(root.rglob('*')):
+    if path.suffix in {'.h', '.hpp'} and '__pycache__' not in path.parts:
+        print(path.relative_to(root.parent).as_posix())
+''',
+        meson.current_source_dir() / 'rgpot',
+        check: true,
+    ).stdout().replace('\r', '').strip().split('\n')
+    install_headers(_public_headers, preserve_path: true)
