diff --git a/meson.build b/meson.build
--- a/meson.build
+++ b/meson.build
@@ -165,14 +165,17 @@
 )
     eigen_dep = dependency('eigen3', required: false)
     if not eigen_dep.found()
-        eigen_dep = dependency(
-            'eigen3',
-            subproject: subproject('eigen'),
-            required: get_option('with_eigen'),
-        )
+        # Prefer CMake package config from conda-forge's eigen package.
+        # Meson rejects dependency(..., subproject: subproject(...)) on
+        # current meson (unknown keyword "subproject").
+        eigen_dep = dependency(
+            'Eigen3',
+            method: 'cmake',
+            modules: ['Eigen3::Eigen'],
+            required: false,
+        )
     endif
     if eigen_dep.found()
         _deps += eigen_dep
         has_eigen = true
     endif
