From: conda-forge staged-recipes
Subject: [PATCH] relax microdf_python upper pin

Allow microdf-python releases newer than 1.3.x.
---
 pyproject.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/pyproject.toml b/pyproject.toml
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -22,7 +22,7 @@
     "pydantic>=2.10.0",
     "pandas>=2.0.0",
     "h5py>=3.0.0",
-    "microdf_python>=1.3.0,<1.4",
+    "microdf_python>=1.3.0",
     "jsonschema>=4.0.0",
     "requests>=2.31.0",
     "psutil>=5.9.0",
