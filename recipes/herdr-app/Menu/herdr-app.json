{
    "$schema": "https://schemas.conda.org/menuinst-1-1-0.schema.json",
    "menu_name": "Herdr",
    "menu_items": [
        {
            "name": "Herdr",
            "description": "Terminals and coding agents that keep running",
            "command": [
                "{{ BIN_DIR }}/herdr-app"
            ],
            "icon": "{{ MENU_DIR }}/herdr-app.{{ ICON_EXT }}",
            "activate": false,
            "terminal": false,
            "platforms": {
                "linux": {
                    "Categories": [
                        "Development",
                        "TerminalEmulator"
                    ],
                    "StartupNotify": true,
                    "StartupWMClass": "herdr-app"
                },
                "osx": {
                    "command": [
                        "{{ PREFIX }}/Applications/Herdr.app/Contents/MacOS/Herdr"
                    ],
                    "CFBundleName": "Herdr",
                    "CFBundleDisplayName": "Herdr",
                    "CFBundleIdentifier": "dev.herdr.app.menuinst",
                    "CFBundleVersion": "{{ PKG_VERSION }}"
                },
                "win": {
                    "command": [
                        "{{ BIN_DIR }}/herdr-app.exe"
                    ],
                    "desktop": false
                }
            }
        }
    ]
}
