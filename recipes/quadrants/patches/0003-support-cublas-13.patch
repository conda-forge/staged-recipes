From 7d3431691024674d20751c9dd782e17b5e484590 Mon Sep 17 00:00:00 2001
From: Jeongseok Lee <jeongseok@meta.com>
Date: Sat, 29 Aug 2026 10:10:00 -0700
Subject: [PATCH] Support the CUDA 13 cuBLAS SONAME

CUDA 13 packages provide libcublas.so.13 / cublas64_13.dll. Keep the
existing preference for versions 11 and 12, which supports environments
that supply CUDA libraries through PyTorch, while accepting version 13
when it is the available runtime.
---
 quadrants/rhi/cuda/cuda_driver.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/quadrants/rhi/cuda/cuda_driver.cpp b/quadrants/rhi/cuda/cuda_driver.cpp
index 07ef24a..8a9eaf1 100644
--- a/quadrants/rhi/cuda/cuda_driver.cpp
+++ b/quadrants/rhi/cuda/cuda_driver.cpp
@@ -244,7 +244,7 @@ bool CUBLASDriver::load_cublas() {
    * it would confict with torch's cublas. When using libcublas.so.11, the
    * torch's cublas will be loaded.
    */
-  cublas_loaded_ = try_load_lib_any_version("cublas", "64_", {11, 12, 10});
+  cublas_loaded_ = try_load_lib_any_version("cublas", "64_", {11, 12, 13, 10});
   if (!cublas_loaded_) {
     return false;
   }
-- 
