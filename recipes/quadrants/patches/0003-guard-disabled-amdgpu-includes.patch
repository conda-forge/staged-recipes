From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: conda-forge staged-recipes <conda-forge@users.noreply.github.com>
Date: Thu, 27 Aug 2026 15:00:00 -0700
Subject: [PATCH] Guard AMDGPU-only runtime headers

The inline AmdgpuDevice vtable references AMDGPUContext even when the backend
is disabled.  Keeping the AMDGPU runtime headers inside the existing feature
guard prevents unresolved AMDGPU symbols in CUDA/Vulkan-only builds.
---
 quadrants/runtime/llvm/llvm_runtime_executor.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/quadrants/runtime/llvm/llvm_runtime_executor.cpp b/quadrants/runtime/llvm/llvm_runtime_executor.cpp
index c541b6af3..82a713f61 100644
--- a/quadrants/runtime/llvm/llvm_runtime_executor.cpp
+++ b/quadrants/runtime/llvm/llvm_runtime_executor.cpp
@@ -26,9 +26,9 @@
 #endif
 
 #include "quadrants/platform/amdgpu/detect_amdgpu.h"
+#if defined(QD_WITH_AMDGPU)
 #include "quadrants/rhi/amdgpu/amdgpu_driver.h"
 #include "quadrants/rhi/amdgpu/amdgpu_device.h"
-#if defined(QD_WITH_AMDGPU)
 #include "quadrants/rhi/amdgpu/amdgpu_context.h"
 #endif
 
