{
  "$schema": "https://schemas.conda.org/menuinst/menuinst-1-1-3.schema.json",
  "menu_name": "Patinae",
  "menu_items": [
    {
      "name": "Patinae",
      "description": "A fast, programmable molecular viewer for research, scripting, and the web",
      "icon": "{{ MENU_DIR }}/patinae.{{ ICON_EXT }}",
      "command": ["{{ BIN_DIR }}/patinae"],
      "platforms": {
        "linux": {
          "Categories": ["Education", "Science"],
          "GenericName": "Molecular Viewer",
          "StartupNotify": true,
          "StartupWMClass": "patinae"
        },
        "osx": {
          "CFBundleIdentifier": "io.github.zmactep.patinae",
          "CFBundleVersion": "__PKG_VERSION__",
          "CFBundleDisplayName": "Patinae"
        },
        "win": {
          "command": ["{{ SCRIPTS_DIR }}\\patinae.bat"],
          "desktop": true
        }
      }
    }
  ]
}
