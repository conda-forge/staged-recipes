# Fix stale version metadata and Windows DLL exports/install layout.
# Rename the Windows static archive to avoid colliding with the import library.
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -2,7 +2,7 @@
 # Copyright (c) 2021, Daan Leijen
 # -----------------------------------------------------------------------------
 cmake_minimum_required(VERSION 3.10)
-project(libisocline C CXX ASM)
+project(libisocline C)
 
 set(CMAKE_C_STANDARD   99)
 set(CMAKE_CXX_STANDARD 11)
@@ -171,8 +171,9 @@
 add_library(isocline_shared SHARED ${ic_sources})
 set_target_properties(isocline_shared PROPERTIES
     OUTPUT_NAME isocline
-    VERSION 1.0.9
+    VERSION 1.1.0
     SOVERSION 1
+    WINDOWS_EXPORT_ALL_SYMBOLS ON
 )
 target_compile_options(isocline_shared PRIVATE ${ic_cflags})
 target_compile_definitions(isocline_shared PRIVATE ${ic_cdefs})
@@ -188,9 +189,14 @@
 
 include(GNUInstallDirs)
 
+if(WIN32)
+  set_target_properties(isocline PROPERTIES OUTPUT_NAME isocline_static)
+endif()
+
 install(TARGETS isocline isocline_shared
     ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
     LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
 )
 
 install(FILES include/isocline.h DESTINATION ${CMAKE_INSTALL_INCLUDEDIR})
--- a/isocline.pc.in
+++ b/isocline.pc.in
@@ -5,6 +5,6 @@
 
 Name: isocline
 Description: Portable alternative to GNU Readline
-Version: 1.0.9
+Version: 1.1.0
 Libs: -L${libdir} -lisocline
 Cflags: -I${includedir}
