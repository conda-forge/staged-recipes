From 7b20ca463be2510d51259f27f20eaba9b0aa3519 Mon Sep 17 00:00:00 2001
From: Tobias Fischer <info@tobiasfischer.info>
Date: Fri, 30 Oct 2026 21:29:00 +1000
Subject: [PATCH 6/7] Add OPTION_USE_SYSTEM_QCUSTOMPLOT to use an installed
 QCustomPlot

find_package(qcustomplot) instead of the bundled extern/QCustomPlot; off by default.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 qCC/CMakeLists.txt | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/qCC/CMakeLists.txt b/qCC/CMakeLists.txt
index 5717d580..9e8c81a5 100644
--- a/qCC/CMakeLists.txt
+++ b/qCC/CMakeLists.txt
@@ -31,7 +31,13 @@ file( GLOB txt_list TODO.txt ${CloudCompareProjects_SOURCE_DIR}/CHANGELOG.md )
 add_subdirectory( db_tree )
 add_subdirectory( pluginManager )
 
-add_subdirectory( extern/QCustomPlot EXCLUDE_FROM_ALL )
+option( OPTION_USE_SYSTEM_QCUSTOMPLOT "Use an installed QCustomPlot (CMake package) instead of the bundled copy" OFF )
+if( OPTION_USE_SYSTEM_QCUSTOMPLOT )
+	find_package( qcustomplot 2.1 CONFIG REQUIRED )
+	add_library( QCustomPlot ALIAS qcustomplot::qcustomplot )
+else()
+	add_subdirectory( extern/QCustomPlot EXCLUDE_FROM_ALL )
+endif()
 
 qt6_wrap_ui( generated_ui_list ${ui_list} )
 qt6_add_resources( generated_qrc_list ${qrc_list} )
-- 
