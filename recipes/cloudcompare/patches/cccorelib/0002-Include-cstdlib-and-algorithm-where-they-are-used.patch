From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tobias Fischer <tobias.fischer@qut.edu.au>
Subject: [PATCH] Include <cstdlib> and <algorithm> where they are used

CloudSamplingTools.cpp calls rand() and ScalarField.h std::fill(); with
libc++ 23 neither header is pulled in indirectly any more.
---
 include/ScalarField.h      | 1 +
 src/CloudSamplingTools.cpp | 1 +
 2 files changed, 2 insertions(+)

diff --git a/include/ScalarField.h b/include/ScalarField.h
index cf53320..bdb24e8 100644
--- a/include/ScalarField.h
+++ b/include/ScalarField.h
@@ -7,6 +7,7 @@
 #include "CCConst.h"
 
 // System
+#include <algorithm>
 #include <cassert>
 #include <memory>
 #include <string>
diff --git a/src/CloudSamplingTools.cpp b/src/CloudSamplingTools.cpp
index 797a9b5..f92b63e 100644
--- a/src/CloudSamplingTools.cpp
+++ b/src/CloudSamplingTools.cpp
@@ -16,6 +16,7 @@
 
 //system
 #include <algorithm>
+#include <cstdlib>
 #include <random>
 
 using namespace CCCoreLib;
