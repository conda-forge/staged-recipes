From 3d3f2e49f8d2fe7e6ecb13ea9c5f62f5b9f961b9 Mon Sep 17 00:00:00 2001
From: Tobias Fischer <tobias.fischer@qut.edu.au>
Date: Fri, 30 Oct 2026 18:21:36 +1000
Subject: [PATCH 2/7] Add OPTION_USE_SYSTEM_SHAPE_LIB to use an installed
 ShapeLib

find_package(shapelib) instead of the bundled extern/shapelib; off by default.
---
 libs/qCC_io/CMakeLists.txt | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/libs/qCC_io/CMakeLists.txt b/libs/qCC_io/CMakeLists.txt
index afd11b56..3d3ae3ee 100644
--- a/libs/qCC_io/CMakeLists.txt
+++ b/libs/qCC_io/CMakeLists.txt
@@ -16,10 +16,16 @@ if( ${OPTION_USE_DXF_LIB} )
 endif()
 
 option( OPTION_USE_SHAPE_LIB "Build with ShapeLib (SHP files support)" ON )
+option( OPTION_USE_SYSTEM_SHAPE_LIB "Use an installed ShapeLib instead of the bundled copy" OFF )
 if( ${OPTION_USE_SHAPE_LIB} )
-	set( SHAPELIB_LIB_DIR "extern/shapelib" CACHE PATH "shapelib lib path" )
-	add_subdirectory( "${SHAPELIB_LIB_DIR}" )
-	target_link_libraries( ${PROJECT_NAME} PUBLIC shapelib )
+	if( ${OPTION_USE_SYSTEM_SHAPE_LIB} )
+		find_package( shapelib CONFIG REQUIRED )
+		target_link_libraries( ${PROJECT_NAME} PUBLIC shapelib::shp )
+	else()
+		set( SHAPELIB_LIB_DIR "extern/shapelib" CACHE PATH "shapelib lib path" )
+		add_subdirectory( "${SHAPELIB_LIB_DIR}" )
+		target_link_libraries( ${PROJECT_NAME} PUBLIC shapelib )
+	endif()
 	target_compile_definitions( ${PROJECT_NAME} PUBLIC CC_SHP_SUPPORT )
 endif()
 
