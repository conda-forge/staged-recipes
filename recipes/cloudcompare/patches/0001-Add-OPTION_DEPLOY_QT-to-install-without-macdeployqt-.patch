From 718a9f436826c2a74795565ac5d33b12e950f82d Mon Sep 17 00:00:00 2001
From: Tobias Fischer <tobias.fischer@qut.edu.au>
Date: Fri, 30 Oct 2026 18:21:36 +1000
Subject: [PATCH 1/7] Add OPTION_DEPLOY_QT to install without
 macdeployqt/windeployqt

Package managers (conda-forge, Homebrew, ...) provide Qt and the other
dependencies, so the applications must not bundle copies of them.
OPTION_DEPLOY_QT (default ON, unchanged behaviour) turns the
macdeployqt/windeployqt step off. Without it, macOS uses the Linux layout
instead of application bundles: executables in bin/, the shared libraries in
lib/cloudcompare, plugins in lib/cloudcompare/plugins, shaders and
translations in share/cloudcompare, with install rpaths to lib/cloudcompare
and to the dependencies' directories. ccApplicationBase finds plugins and
shaders there when the executable runs from a bin/ directory on macOS.
---
 CMakeLists.txt                             | 22 +++++++++--
 ccViewer/CMakeLists.txt                    | 12 +++---
 cmake/DeployQt.cmake                       | 10 ++++-
 cmake/Install.cmake                        |  2 +-
 libs/CCAppCommon/src/ccApplicationBase.cpp | 45 ++++++++++++++--------
 qCC/CMakeLists.txt                         | 12 +++---
 qCC/translations/CMakeLists.txt            |  2 +-
 7 files changed, 70 insertions(+), 35 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 4e62a6a4..31b79949 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -29,9 +29,19 @@ endif()
 # Default debug suffix for libraries.
 set( CMAKE_DEBUG_POSTFIX "d" )
 
+# Copy Qt and the other dependencies next to the applications (macdeployqt /
+# windeployqt). Package managers that provide them turn this off.
+option( OPTION_DEPLOY_QT "Bundle Qt and the other dependencies with the applications (macOS, Windows)" ON )
+# Without them, macOS uses the Linux layout: bin/, lib/cloudcompare, share/cloudcompare
+if( APPLE AND OPTION_DEPLOY_QT )
+	set( CC_MACOS_BUNDLE ON )
+else()
+	set( CC_MACOS_BUNDLE OFF )
+endif()
+
 # Define target folders
 # (now that ccViewer can have its own plugins, qCC and ccViewer must fall in separate folders!
-if(WIN32 OR APPLE)
+if(WIN32 OR CC_MACOS_BUNDLE)
 	set( CLOUDCOMPARE_DEST_FOLDER CloudCompare )
 	set( CCVIEWER_DEST_FOLDER ccViewer )
 else()
@@ -45,12 +55,16 @@ if( WIN32 )
     if( ${OPTION_BUILD_CCVIEWER} )
         list( APPEND INSTALL_DESTINATIONS ${CCVIEWER_DEST_FOLDER} )
 	endif()
-elseif( UNIX AND NOT APPLE )
-	# RPATH Linux/Unix: (dynamic) libs are put in $prefix/$lib/cloudcompare,
-	# since they are only used by qCC/ccViewer
+elseif( UNIX AND NOT CC_MACOS_BUNDLE )
+	# RPATH Linux/Unix (and macOS without macdeployqt, e.g. for package managers):
+	# (dynamic) libs are put in $prefix/$lib/cloudcompare, since they are only used
+	# by qCC/ccViewer; Qt and the other dependencies are found where they are installed
 	include( GNUInstallDirs )
 	set( LINUX_INSTALL_SHARED_DESTINATION "${CMAKE_INSTALL_FULL_LIBDIR}/cloudcompare" )
 	set( CMAKE_INSTALL_RPATH ${LINUX_INSTALL_SHARED_DESTINATION} )
+	if( APPLE )
+		set( CMAKE_INSTALL_RPATH_USE_LINK_PATH ON )
+	endif()
 	set( INSTALL_DESTINATIONS ${CMAKE_INSTALL_PREFIX})
 endif()
 
diff --git a/ccViewer/CMakeLists.txt b/ccViewer/CMakeLists.txt
