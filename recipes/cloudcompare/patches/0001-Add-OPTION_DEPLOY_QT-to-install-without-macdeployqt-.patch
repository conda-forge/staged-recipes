-if (NOT APPLE)
+if (NOT CC_MACOS_BUNDLE)
 	# install program
 	install_ext( TARGETS ccViewer ${CCVIEWER_DEST_FOLDER} "" )
 endif()
@@ -97,16 +97,16 @@ if( WIN32 )
 endif()
 
 # Install auxiliary files
-if(APPLE OR WIN32) # For Linux it's already installed in by qCC
+if(CC_MACOS_BUNDLE OR WIN32) # For Linux it's already installed in by qCC
 	foreach( filename ${auxFiles} )
 		install_ext( FILES ${filename} ${CCVIEWER_DEST_FOLDER} "" )
 	endforeach()
 endif()
 
 # Put together our Application bundle on macOS
-if( APPLE )
+if( CC_MACOS_BUNDLE )
 	add_subdirectory( Mac )
-endif( APPLE )
+endif( CC_MACOS_BUNDLE )
 
 # Export common shader files to all install destinations
 if( WIN32 ) # For Linux it's already installed in by qCC
@@ -114,7 +114,7 @@ if( WIN32 ) # For Linux it's already installed in by qCC
 endif()
 
 # Install plugins & shaders in the correct folder for each platform
-if( APPLE )	
+if( CC_MACOS_BUNDLE )	
 	InstallPlugins(
 		TYPES "gl;io"
 		DEST_PATH "${CCVIEWER_MAC_PLUGIN_DIR}"
diff --git a/cmake/DeployQt.cmake b/cmake/DeployQt.cmake
index a7dd3e1d..f9f5ca29 100644
--- a/cmake/DeployQt.cmake
+++ b/cmake/DeployQt.cmake
@@ -7,7 +7,9 @@ find_package( Qt6
 get_target_property( qmake_location Qt6::qmake IMPORTED_LOCATION )
 get_filename_component( qt6_bin_dir ${qmake_location} DIRECTORY )
 
-if ( APPLE )
+if ( NOT OPTION_DEPLOY_QT )
+	# the applications are installed without their dependencies (see DeployQt)
+elseif ( APPLE )
 	find_program( mac_deploy_qt macdeployqt HINTS "${qt6_bin_dir}" )
 
 	if( NOT EXISTS "${mac_deploy_qt}" )
@@ -41,6 +43,12 @@ function( DeployQt )
 	# For readability
 	set( deploy_path "${DEPLOY_QT_DEPLOY_PATH}" )
 
+	if( NOT OPTION_DEPLOY_QT )
+		# The application is installed like on Linux (install_ext), its dependencies
+		# are found where they are installed (e.g. by a package manager)
+		return()
+	endif()
+
 	message( STATUS "Installing ${DEPLOY_QT_TARGET} to ${deploy_path}" )
 
 	get_target_property( name ${DEPLOY_QT_TARGET} NAME )
diff --git a/cmake/Install.cmake b/cmake/Install.cmake
index ccb5a980..f8d7a27c 100644
