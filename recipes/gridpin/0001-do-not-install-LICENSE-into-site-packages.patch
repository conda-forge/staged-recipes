Do not install a copy of LICENSE at the top of site-packages.

maturin already ships the license file in the dist-info (licenses/LICENSE); the extra
include rule also wrote it to site-packages/LICENSE, a generic name other packages may use.

--- a/pyproject.toml
+++ b/pyproject.toml
@@ -27,7 +27,3 @@

 [tool.maturin]
 features = ["python"]
-# Ship the Apache license text INSIDE the wheel (the `license = {text=...}` field only records the
-# SPDX id in metadata, it does not bundle the file). gridpin/LICENSE is a committed copy of the
-# repo-root LICENSE, so the build never depends on a CI-time copy.
-include = [{ path = "LICENSE", format = "wheel" }]
