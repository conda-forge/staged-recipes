From: conda-forge staged-recipes
Subject: [PATCH] Drop unused nptyping and dev tools from dependencies

nptyping is never imported and every release caps numpy<2.
---
 pyproject.toml | 4 ----
 1 file changed, 4 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -19,17 +19,13 @@
     "Topic :: Scientific/Engineering :: Information Analysis",
 ]
 dependencies = [
-    "coverage<7",
     "dpath<3",
     "h5py>=3,<4",
-    "ruff>=0.9.0",
     "microdf_python>=1.2.1",
-    "nptyping<2",
     "numexpr<3",
     "pandas>=2.2.0",
     "plotly>=5.6.0,<6",
     "policyengine_core>=3.23.6",
-    "pytest",
     "requests>=2.27.1,<3",
     "sortedcontainers<3",
     "tqdm>=4.46.0,<5",
