From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tobias Fischer <tobias.fischer@qut.edu.au>
Date: Fri, 30 Oct 2026 15:54:03 +1000
Subject: [PATCH 2/2] Declare IndexType in the custom nanoflann result sets
 (nanoflann 2.0)

---
 include/py4dgeo/kdtree.hpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/include/py4dgeo/kdtree.hpp b/include/py4dgeo/kdtree.hpp
index bac45c6..267c682 100644
--- a/include/py4dgeo/kdtree.hpp
+++ b/include/py4dgeo/kdtree.hpp
@@ -56,6 +56,8 @@ private:
   struct NoDistancesReturnSet
   {
     using DistanceType = double;
+    // nanoflann >= 2.0 casts the found indices to the result set's IndexType
+    using IndexType = ::py4dgeo::IndexType;
 
     double radius;
     RadiusSearchResult& indices;
@@ -100,6 +102,8 @@ private:
   struct WithDistancesReturnSet
   {
     using DistanceType = double;
+    // nanoflann >= 2.0 casts the found indices to the result set's IndexType
+    using IndexType = ::py4dgeo::IndexType;
 
     double radius;
     RadiusSearchDistanceResult& result;
-- 
2.53.0

