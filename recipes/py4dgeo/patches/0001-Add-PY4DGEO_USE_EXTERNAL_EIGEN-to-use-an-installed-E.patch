From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tobias Fischer <tobias.fischer@qut.edu.au>
Date: Thu, 12 Nov 2026 08:29:12 +1000
Subject: [PATCH] Add PY4DGEO_USE_EXTERNAL_EIGEN to use an installed Eigen3

---
 CMakeLists.txt | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 25d6056..fa4dc5f 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -84,8 +84,15 @@ target_compile_features(nanoflann
 # -----------------
 # Eigen3 dependency
 # -----------------
-set(EIGEN_BUILD_TESTING OFF CACHE BOOL "Disable Eigen tests" FORCE)
-add_subdirectory(ext/eigen EXCLUDE_FROM_ALL)
+set(PY4DGEO_USE_EXTERNAL_EIGEN
+    OFF
+    CACHE BOOL "Use an installed Eigen3 instead of the copy in ext/eigen")
+if(PY4DGEO_USE_EXTERNAL_EIGEN)
+  find_package(Eigen3 CONFIG REQUIRED)
+else()
+  set(EIGEN_BUILD_TESTING OFF CACHE BOOL "Disable Eigen tests" FORCE)
+  add_subdirectory(ext/eigen EXCLUDE_FROM_ALL)
+endif()
 
 # -----------------------------------
 # Link nanoflann and eigen to py4dgeo
