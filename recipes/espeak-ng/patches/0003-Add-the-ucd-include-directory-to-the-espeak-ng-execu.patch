From 33e2a1a1bf001d6dcbaa0cf88317008cb05c646a Mon Sep 17 00:00:00 2001
From: Pavel Zwerschke <pavelzw@users.noreply.github.com>
Date: Wed, 25 Nov 2026 15:37:20 +0100
Subject: [PATCH] Add the ucd include directory to the espeak-ng executable

src/include/compat/wchar.h includes <ucd/ucd.h>. With older glibc
(e.g. 2.17), stdio.h includes wchar.h via _G_config.h, so compiling
espeak-ng.c fails because the executable target does not see the ucd
include directory (ucd is only a private dependency of libespeak-ng).
---
 src/CMakeLists.txt | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 85ead54..b98ffb8 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -10,6 +10,10 @@ set_target_properties(espeak-ng-bin PROPERTIES OUTPUT_NAME espeak-ng)
 target_link_libraries(
   espeak-ng-bin PRIVATE espeak-ng espeak-ng-config
 )
+# compat/wchar.h includes <ucd/ucd.h>; with older glibc, stdio.h pulls in wchar.h
+target_include_directories(
+  espeak-ng-bin PRIVATE $<TARGET_PROPERTY:ucd,INTERFACE_INCLUDE_DIRECTORIES>
+)
 set_target_properties(
   espeak-ng-bin PROPERTIES
   MACOSX_RPATH ON
-- 
2.56.1

