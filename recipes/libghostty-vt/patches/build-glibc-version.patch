 pub fn build(b: *std.Build) !void {
+    // Match build-time tools to the libc installation supplied by the packager.
+    // Native host detection otherwise selects APIs newer than the sysroot.
+    if (b.option([]const u8, "build-glibc-version", "glibc version for build-time tools")) |version| {
+        var query = b.graph.host.query;
+        query.cpu_arch = b.graph.host.result.cpu.arch;
+        query.os_tag = b.graph.host.result.os.tag;
+        query.abi = b.graph.host.result.abi;
+        query.glibc_version = try std.SemanticVersion.parse(version);
+        b.graph.host = b.resolveTargetQuery(query);
+    }
+
