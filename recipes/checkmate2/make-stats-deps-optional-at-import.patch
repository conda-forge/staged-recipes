From a11db6996143865f36ca6f1fe71d51f9a82c852d Mon Sep 17 00:00:00 2001
From: Matthew Feickert <matthew.feickert@cern.ch>
Date: Tue, 4 Aug 2026 20:29:49 -0600
Subject: [PATCH 1/3] fix: Route '--help' to the argument parser

* Only the literal '-h' was special-cased when CheckMATE was invoked
with a single argument, so 'CheckMATE --help' was treated as an input
file and exited with "Parameter file '--help' does not exist." instead
of printing the argparse help. Accept '--help' as well; both forms now
print the help text and exit 0.
---
 tools/python/checkmate_core.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tools/python/checkmate_core.py b/tools/python/checkmate_core.py
index 1e1cea5..b5fbb35 100644
--- a/tools/python/checkmate_core.py
+++ b/tools/python/checkmate_core.py
@@ -34,7 +34,7 @@ class CheckMATE2(object):
         if len(sys.argv) == 1:
             self.printUsage()
         self.printLogo()
-        if len(sys.argv) == 2 and sys.argv[-1] != "-h":
+        if len(sys.argv) == 2 and sys.argv[-1] not in ("-h", "--help"):
             Info.fill_info_from_file(sys.argv[1])            
             self.procList = Info.fill_processes_from_file(sys.argv[1])
             print(self.procList)
-- 
