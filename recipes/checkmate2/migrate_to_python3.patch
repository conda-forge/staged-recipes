   py_cv_python_prefix="$PYTHON_PREFIX"
 fi
@@ -84,7 +84,7 @@ fi
 AC_MSG_CHECKING(python installation exec_prefix)
 if test -z "$PYTHON_EXEC_PREFIX"; then
