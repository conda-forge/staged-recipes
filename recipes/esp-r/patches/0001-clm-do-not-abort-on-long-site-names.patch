The site name of a weather file is stored in CFLOC (42 characters). Reading
a longer name (e.g. the 43 characters of GBR_Channel_Islands.a) through an
internal WRITE aborts clm with "Fortran runtime error: End of record", so the
weather file cannot be converted to binary at install time. Use an assignment,
which truncates the name instead.

--- a/src/eclm/cfiles.F	2026-11-16 07:50:44.424561829 +0100
+++ b/src/eclm/cfiles.F	2026-11-16 07:50:44.429561807 +0100
@@ -165,7 +165,7 @@
 
 C Header line 1: location          
           CALL STRIPC(IUNIT,OUTSTR,0,ND,1,'weather head 1',IER)
-          write(CFLOC,'(a)') OUTSTR(1:lnblnk(OUTSTR))
+          CFLOC=OUTSTR(1:lnblnk(OUTSTR))
 
 C Header line 2: year, latitude, longitude difference
           CALL STRIPC(IUNIT,OUTSTR,3,ND,1,'weather head 2',IER)
@@ -228,7 +228,7 @@
 
 C Header line 1: location          
           CALL STRIPC(IUNIT,OUTSTR,0,ND,1,'clm head 1',IER)
-          write(CFLOC,'(a)') OUTSTR(1:lnblnk(OUTSTR))
+          CFLOC=OUTSTR(1:lnblnk(OUTSTR))
 
 C Header line 2: year, latitude, longitude difference
           CALL STRIPC(IUNIT,OUTSTR,3,ND,1,'clm head 2',IER)
@@ -280,7 +280,7 @@
           CALL STRIPC(IUNIT,OUTSTR,0,ND,1,'clm head 3',IER)
         elseif(ICDESC.eq.1)then
           CALL STRIPC(IUNIT,OUTSTR,0,ND,1,'clm head 1',IER)
-          write(CFLOC,'(a)') OUTSTR(1:lnblnk(OUTSTR))
+          CFLOC=OUTSTR(1:lnblnk(OUTSTR))
 
           CALL STRIPC(IUNIT,OUTSTR,99,ND,1,'clm head 2',IER)
           K=0
