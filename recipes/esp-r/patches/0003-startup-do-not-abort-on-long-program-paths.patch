FINDAPP copies the file name of the running program (the part of the
command-line path after the last '/') into a 24-character string through an
internal WRITE. The path itself is read into a 72-character string, so when
a program is started through a longer path the truncated path can end in a
long directory-name fragment, and the WRITE aborts the program with
"Fortran runtime error: End of record". Use plain assignments, which
truncate: the name is only used in messages.

--- a/src/common/startup.F
+++ b/src/common/startup.F
@@ -1022,15 +1022,15 @@
 C If islash = 0 then no root.
 100   if(islash.eq.0)then
         if(ilstr.ge.ilfilen)then
-          write(appn,'(a)')string(1:ilfilen)
+          appn=string(1:ilfilen)
         elseif(ilstr.lt.ilfilen)then
-          write(appn,'(a)')string(1:lnblnk(string))
+          appn=string(1:lnblnk(string))
         endif
       else
 
 C If islash > 0 then root and file name
         is=islash+1
-        write(appn,'(a)') string(is:lnblnk(string))
+        appn=string(is:lnblnk(string))
       endif
 
       RETURN
