 class BuildSZ3Extension(_build_ext):
 
     def run(self):
+        sz3_prefix = os.environ.get("PYSZ_SZ3_PREFIX")
+        if sz3_prefix:
+            # An installed SZ3 (its headers) and the Zstd installed beside it, as a distribution builds it.
+            prefix = Path(sz3_prefix)
