+                ext.include_dirs.insert(0, str(prefix / "include"))
+                ext.library_dirs.append(str(prefix / "lib"))
+                ext.libraries.append("zstd")
+                # The distribution's compiler flags set the deployment target.
+                ext.extra_compile_args = [a for a in ext.extra_compile_args
+                                          if not a.startswith("-mmacosx-version-min")]
+            super().run()
+            return
+
