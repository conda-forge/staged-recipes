diff --git a/external/CMakeLists.txt b/external/CMakeLists.txt
index 3730bc0..2b1576b 100644
--- a/external/CMakeLists.txt
+++ b/external/CMakeLists.txt
@@ -1,11 +1,69 @@
+# Dependencies are resolved with find_package() by default so that HiggsTools
+# can be built against system / package-manager provided libraries (e.g.
+# conda-forge, Spack, distribution packages) without network access at
+# configure time. Set HiggsTools_FETCH_DEPENDENCIES=ON to restore the old
+# behaviour of downloading pinned versions with FetchContent.
+option(HiggsTools_FETCH_DEPENDENCIES
+       "Download dependencies with FetchContent instead of find_package" OFF)
+
+if(NOT HiggsTools_FETCH_DEPENDENCIES)
+  find_package(range-v3 REQUIRED CONFIG)
+  find_package(magic_enum REQUIRED CONFIG)
+  find_package(fmt REQUIRED CONFIG)
+  find_package(spdlog REQUIRED CONFIG)
+  find_package(nlohmann_json 3.10 REQUIRED CONFIG)
+  # No version request: Eigen 5's Eigen3ConfigVersion.cmake rejects a 3.x
+  # request, while HiggsTools builds with both Eigen 3.4 and 5.
+  find_package(Eigen3 REQUIRED NO_MODULE)
+  if(${PROJECT_NAME}_BUILD_PYTHON_MODULE)
+    find_package(Python REQUIRED COMPONENTS Interpreter Development.Module)
+    find_package(pybind11 REQUIRED CONFIG)
+  endif()
+
+  # magic_enum >= 0.9.4 installs its headers to include/magic_enum/ while
+  # HiggsTools uses #include <magic_enum.hpp>.
+  find_path(
+    HiggsTools_MAGIC_ENUM_INCLUDE_DIR magic_enum.hpp
+    PATH_SUFFIXES magic_enum
+    HINTS ${magic_enum_DIR}/../../../include)
+  if(HiggsTools_MAGIC_ENUM_INCLUDE_DIR)
+    set_property(
+      TARGET magic_enum::magic_enum
+      APPEND
+      PROPERTY INTERFACE_INCLUDE_DIRECTORIES
+               ${HiggsTools_MAGIC_ENUM_INCLUDE_DIR})
+  endif()
+  # Imported targets are directory-scoped; this directory is added with
+  # add_subdirectory(), so promote them for use in src/ and python/.
+  if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.21)
+    get_property(
+      _higgstools_imported
+      DIRECTORY
+      PROPERTY IMPORTED_TARGETS)
+  else()
+    set(_higgstools_imported
+        range-v3::range-v3 range-v3::meta range-v3::concepts
+        magic_enum::magic_enum fmt::fmt spdlog::spdlog
+        nlohmann_json::nlohmann_json Eigen3::Eigen)
+  endif()
+  foreach(_tgt IN LISTS _higgstools_imported)
+    if(TARGET ${_tgt})
+      set_target_properties(${_tgt} PROPERTIES IMPORTED_GLOBAL TRUE)
+    endif()
+  endforeach()
+  return()
+endif()
+
 include(FetchContent)
 
