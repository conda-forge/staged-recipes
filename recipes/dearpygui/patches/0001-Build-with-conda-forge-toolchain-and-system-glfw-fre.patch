 elseif(APPLE)
 
@@ -74,9 +73,10 @@ else() # Linux
 	add_definitions(-DIMGUI_IMPL_OPENGL_LOADER_GL3W)
 	target_link_libraries(_dearpygui 
 		PRIVATE 
-			"-fPIC -lcrypt -lpthread -ldl  -lutil -lm"
