From f35a35f2b7af63bd79b407df23742acc32d4e10b Mon Sep 17 00:00:00 2001
From: Pavel Zwerschke <pavel.zwerschke@quantco.com>
Date: Fri, 9 Oct 2026 09:08:13 +0200
Subject: [PATCH] Build with conda-forge toolchain and system glfw/freetype

- Run a generic CMake/Ninja build from setup.py that honors CMAKE_ARGS
  instead of hardcoded per-platform commands (Visual Studio paths, etc.).
- Use glfw (and freetype on Windows) from the host environment instead of
  the vendored git submodules.
- Link X11 explicitly on Linux; imgui's GLFW backend calls Xlib directly,
  which was previously satisfied by the statically linked vendored glfw.
- Don't link libcrypt on Linux; it is unused and not part of newer glibc.
- Don't bundle vcruntime140_1.dll; conda provides the VC runtime.
- Include <mutex> in mvContext.h for std::recursive_mutex; newer libc++
  no longer provides it transitively.
---
 CMakeLists.txt         |  7 +++++-
 setup.py               | 54 +++++++++++++-----------------------------
 src/distribution.cmake |  6 ++---
 src/mvContext.h        |  1 +
 4 files changed, 26 insertions(+), 42 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 33a5405..80cc6c4 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -67,7 +67,12 @@ if(MV_NO_USER_THREADS)
     add_definitions(-DMV_NO_USER_THREADS)
 endif()
 
-add_subdirectory("thirdparty")
+find_package(glfw3 REQUIRED)
+if(WIN32)
+    find_package(Freetype REQUIRED)
+elseif(NOT APPLE)
+    find_package(X11 REQUIRED)
+endif()
 
 # if this is not a distribution build
 # build development environment
diff --git a/setup.py b/setup.py
index be68c1c..c13a244 100644
--- a/setup.py
+++ b/setup.py
@@ -8,6 +8,7 @@
