Description: Include <stdio.h> to avoid declaring printf implicitly
 clang 16 and later reject implicit declarations of library functions.
Origin: upstream, https://github.com/coin-or/Csdp/commit/a346b2f

--- a/lib/user_exit.c
+++ b/lib/user_exit.c
@@ -13,6 +13,7 @@
 #include <sys/time.h>
 #include <sys/resource.h>
 #include <signal.h>
+#include <stdio.h>
 
 int sigterm_signaled=0;
 
