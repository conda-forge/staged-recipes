Use the active environment's tzdata on Windows when TZDIR is unset.

--- a/src/time_zone_info.cc
+++ b/src/time_zone_info.cc
@@ -434,6 +434,15 @@ std::unique_ptr<ZoneInfoSource> FileZoneInfoSource::Open(
     char* tzdir_env = nullptr;
 #if defined(_MSC_VER)
     _dupenv_s(&tzdir_env, nullptr, "TZDIR");
+    if (!tzdir_env || !*tzdir_env) {
+      char* prefix = nullptr;
+      _dupenv_s(&prefix, nullptr, "CONDA_PREFIX");
+      if (prefix && *prefix) {
+        path = prefix;
+        tzdir = "/share/zoneinfo";
+      }
+      free(prefix);
+    }
 #else
     tzdir_env = std::getenv("TZDIR");
 #endif
