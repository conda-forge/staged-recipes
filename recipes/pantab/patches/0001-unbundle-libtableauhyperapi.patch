diff --git a/CMakeLists.txt b/CMakeLists.txt
index 18c967f..ba06099 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -19,6 +19,8 @@ execute_process(
 list(APPEND CMAKE_PREFIX_PATH "${NB_DIR}")
 find_package(nanobind CONFIG REQUIRED)
 
+# conda-forge: disabled upstream's own fetch of tableauhyperapi-cxx below
+if(FALSE)
 if(WIN32)
   set(TABLEAU_DOWNLOAD_URL "https://downloads.tableau.com/tssoftware//tableauhyperapi-cxx-windows-x86_64-release-main.0.0.21200.re11c8cb9.zip")
 elseif(APPLE)
@@ -41,7 +43,18 @@ FetchContent_Declare(
 FetchContent_MakeAvailable(tableauhyperapi-cxx)
 list(APPEND CMAKE_PREFIX_PATH "${tableauhyperapi-cxx_SOURCE_DIR}/share/cmake")
 find_package(tableauhyperapi-cxx CONFIG REQUIRED)
+else()
+  # conda-forge: from the libtableauhyperapi package; its share/cmake isn't
+  # nested under a subfolder, so find_package needs it appended explicitly.
+  if(WIN32)
+    list(APPEND CMAKE_PREFIX_PATH "$ENV{LIBRARY_PREFIX}/share/cmake")
+  else()
+    list(APPEND CMAKE_PREFIX_PATH "$ENV{PREFIX}/share/cmake")
+  endif()
+  find_package(tableauhyperapi-cxx CONFIG REQUIRED)
+endif()
 
+include(FetchContent)
 FetchContent_Declare(nanoarrow-project
   GIT_REPOSITORY https://github.com/apache/arrow-nanoarrow.git
   GIT_TAG 3ba38ff09c691cf9320895d04cf441ecb95caa99
