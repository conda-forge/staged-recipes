diff --git a/CMakeLists.txt b/CMakeLists.txt
index 3d3c5da..554e320 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -103,6 +103,28 @@ if (SKBUILD)
 
   list(APPEND CMAKE_PREFIX_PATH "${MI_DRJIT_CMAKE_DIR}")
   find_package(drjit CONFIG REQUIRED)
+
+  # Distribution builds should reuse packaged dependencies instead of
+  # compiling the copies in ext/. This also lets the package manager track
+  # ABI transitions and security updates.
+  find_package(ZLIB REQUIRED)
+  find_package(PNG REQUIRED)
+  find_package(libjpeg-turbo CONFIG REQUIRED)
+  find_package(OpenEXR 3 CONFIG REQUIRED)
+  find_package(pugixml CONFIG REQUIRED)
+  find_package(FastFloat CONFIG REQUIRED)
+  if (MI_ENABLE_EMBREE)
+    find_package(embree 3 CONFIG REQUIRED)
+    add_definitions(-DMI_USE_SYSTEM_EMBREE=1)
+  endif()
+
+  set(ZLIB_LIBRARY ZLIB::ZLIB)
+  set(PNG_LIBRARIES PNG::PNG)
+  set(JPEG_LIBRARIES libjpeg-turbo::jpeg)
+  add_library(IlmImf INTERFACE)
+  target_link_libraries(IlmImf INTERFACE OpenEXR::OpenEXR)
+  add_library(fast_float INTERFACE)
+  target_link_libraries(fast_float INTERFACE FastFloat::fast_float)
 endif()
 
 # ----------------------------------------------------------
@@ -494,19 +516,23 @@ if (MI_COPIED_CONFIG_FILE AND NOT SKBUILD)
 endif()
 
 # Installation targets
-set(MI_DEPEND
-  IlmImf IlmThread Imath Iex IexMath Half pugixml
-)
+set(MI_DEPEND)
+
+if (NOT SKBUILD)
+  list(APPEND MI_DEPEND IlmImf IlmThread Imath Iex IexMath Half)
+endif()
 
 list(APPEND MI_DEPEND struct-jit)
 
-list(APPEND MI_DEPEND png jpeg)
+if (NOT SKBUILD)
+  list(APPEND MI_DEPEND pugixml png jpeg)
+endif()
 
-if (WIN32)
+if (WIN32 AND NOT SKBUILD)
   list(APPEND MI_DEPEND zlib)
 endif()
 
-if (MI_ENABLE_EMBREE)
+if (MI_ENABLE_EMBREE AND NOT SKBUILD)
   list(APPEND MI_DEPEND embree)
 endif()
 
