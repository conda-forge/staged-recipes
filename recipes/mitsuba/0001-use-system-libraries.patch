@@ -213,6 +214,7 @@ if (CMAKE_CXX_COMPILER_ID MATCHES "Clang" OR CMAKE_CXX_COMPILER_ID MATCHES "GNU"
   add_compile_options(-Wno-unused-parameter -Wno-unused-but-set-variable -Wno-sign-compare)
