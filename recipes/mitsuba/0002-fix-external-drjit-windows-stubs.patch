When SKBUILD is enabled, Mitsuba finds an installed Dr.Jit package instead of
adding the vendored Dr.Jit source tree. On MSVC, copy-targets-drjit therefore
does not exist and must not be added to the stub generator dependencies.

diff --git a/src/python/CMakeLists.txt b/src/python/CMakeLists.txt
index 6eaf695..2cef8e6 100644
--- a/src/python/CMakeLists.txt
+++ b/src/python/CMakeLists.txt
@@ -227,7 +227,10 @@ if (MSVC)
   add_custom_target(copy-targets-python ALL)
   set_target_properties(copy-targets-python PROPERTIES FOLDER python)
 
-  list(APPEND MI_STUB_DEPENDS copy-targets-python copy-targets-drjit)
+  list(APPEND MI_STUB_DEPENDS copy-targets-python)
+  if (TARGET copy-targets-drjit)
+    list(APPEND MI_STUB_DEPENDS copy-targets-drjit)
+  endif()
 endif()
 
