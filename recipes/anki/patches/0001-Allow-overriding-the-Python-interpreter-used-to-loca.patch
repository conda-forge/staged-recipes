From 72306d6c0c191980a27d384fe135fe5e06954a8e Mon Sep 17 00:00:00 2001
From: conda-forge <conda-forge@users.noreply.github.com>
Date: Thu, 19 Nov 2026 00:28:05 +0100
Subject: [PATCH] Allow overriding the Python interpreter used to locate
 python3.lib

conda-forge builds don't create Anki's out/pyenv virtual environment, so
let the build script use the PYTHON environment variable instead.
---
 pylib/rsbridge/build.rs | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/pylib/rsbridge/build.rs b/pylib/rsbridge/build.rs
index 4671bc2..7353b58 100644
--- a/pylib/rsbridge/build.rs
+++ b/pylib/rsbridge/build.rs
@@ -14,7 +14,9 @@ fn main() {
         use std::process::Command;
 
         // Run Python to get sysconfig paths
-        let output = Command::new("../../out/pyenv/scripts/python")
+        let python = std::env::var("PYTHON")
+            .unwrap_or_else(|_| "../../out/pyenv/scripts/python".to_string());
+        let output = Command::new(python)
             .args([
                 "-c",
                 "import sysconfig; print(sysconfig.get_paths()['stdlib'])",
-- 
2.56.0

