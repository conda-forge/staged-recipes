From 8d7eb94eadcf339498465c032c6731d3370388d0 Mon Sep 17 00:00:00 2001
From: conda-forge <conda-forge@users.noreply.github.com>
Date: Thu, 19 Nov 2026 00:31:04 +0100
Subject: [PATCH] Call the ruff executable directly when formatting generated
 hooks

conda-forge's ruff package only ships the ruff binary, not an importable
Python module, so `python -m ruff` does not work in the build environment.
---
 pylib/tools/hookslib.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/pylib/tools/hookslib.py b/pylib/tools/hookslib.py
index 99f08fa..c60f422 100644
--- a/pylib/tools/hookslib.py
+++ b/pylib/tools/hookslib.py
@@ -205,4 +205,4 @@ def write_file(path: str, hooks: list[Hook], prefix: str, suffix: str):
 
     with open(path, "wb") as file:
         file.write(code.encode("utf8"))
-    subprocess.run([sys.executable, "-m", "ruff", "format", "-q", path], check=True)
+    subprocess.run(["ruff", "format", "-q", path], check=True)
-- 
2.56.0

