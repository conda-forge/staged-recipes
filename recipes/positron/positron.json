{
  "$schema": "https://schemas.conda.org/menuinst-1-1-3.schema.json",
  "menu_name": "Positron",
  "menu_items": [
    {
      "name": {
        "target_environment_is_base": "Positron",
        "target_environment_is_not_base": "Positron ({{ ENV_NAME }})"
      },
      "description": "A next-generation data science IDE",
      "command": [
        "{{ PREFIX }}/lib/positron/positron"
      ],
      "activate": true,
      "terminal": false,
      "platforms": {
        "linux": {
          "icon": "{{ MENU_DIR }}/positron.png",
          "Categories": [
            "TextEditor",
            "Development",
            "IDE"
          ],
          "StartupNotify": true,
          "StartupWMClass": "Positron"
        },
        "win": {
          "command": [
            "{{ PREFIX }}/Library/lib/positron/Positron.exe"
          ],
          "icon": "{{ MENU_DIR }}/positron.ico",
          "desktop": false
        }
      }
    }
  ]
}
