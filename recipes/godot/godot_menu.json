{
  "$schema": "https://schemas.conda.org/menuinst/menuinst-1-1-3.schema.json",
  "menu_name": "Godot",
  "menu_items": [
    {
      "name": {
        "target_environment_is_base": "Godot Engine",
        "target_environment_is_not_base": "Godot Engine ({{ ENV_NAME }})"
      },
      "description": "Launch the Godot game engine and editor",
      "command": [
        "{{ BIN_DIR }}/godot"
      ],
      "activate": true,
      "terminal": false,
      "platforms": {
        "linux": {
          "icon": "{{ PREFIX }}/share/icons/hicolor/scalable/apps/godot.svg",
          "Categories": [
            "Development",
            "Game"
          ],
          "PrefersNonDefaultGPU": true,
          "StartupWMClass": "Godot"
        },
        "win": {
          "command": [
            "{{ BIN_DIR }}/godot.exe"
          ],
          "icon": "{{ PREFIX }}/Library/share/godot/godot.ico",
          "desktop": true
        }
      }
    }
  ]
}
