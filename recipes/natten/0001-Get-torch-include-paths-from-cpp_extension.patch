From: Mark Harfouche <mark@ramonaoptics.com>
Subject: [PATCH] Get torch include paths from torch.utils.cpp_extension

The CMakeLists hardcodes the torch headers as ${TORCH_DIR}/include, i.e.
site-packages/torch/include. conda-forge's pytorch installs the C++
headers (ATen, c10, torch) into $PREFIX/include instead, so the build
fails with "ATen/ATen.h: No such file or directory".
torch.utils.cpp_extension.include_paths() returns the correct locations
for both the PyPI wheels and conda-forge. Not upstreamed yet; upstream
main (93cf4b4989) still hardcodes the paths.

--- a/csrc/CMakeLists.txt	2026-09-10 18:14:29.947606978 -0400
+++ b/csrc/CMakeLists.txt	2026-09-10 18:14:29.954945667 -0400
@@ -52,7 +52,15 @@
 # I really need to find is the include paths, and let the linker take it from there.
 #list(APPEND CMAKE_PREFIX_PATH ${TORCH_DIR})
 #find_package(Torch REQUIRED)
-set(TORCH_INCLUDE_DIRS "${TORCH_DIR}/include" "${TORCH_DIR}/include/torch/csrc/api/include")
+# Ask torch for its include paths instead of assuming they live under TORCH_DIR;
+# e.g. conda-forge installs the C++ headers into $PREFIX/include.
+execute_process(COMMAND ${PYTHON_PATH} "-c" "from __future__ import print_function; from torch.utils.cpp_extension import include_paths;
+print(';'.join(include_paths()),end='');"
+                RESULT_VARIABLE _PYTHON_SUCCESS
+                OUTPUT_VARIABLE TORCH_INCLUDE_DIRS)
+if (NOT _PYTHON_SUCCESS MATCHES 0)
+    message(FATAL_ERROR "Torch include paths lookup failed.")
+endif()
 message("Torch dir: " ${TORCH_DIR})
 message("Torch include dir: " ${TORCH_INCLUDE_DIRS})
 
