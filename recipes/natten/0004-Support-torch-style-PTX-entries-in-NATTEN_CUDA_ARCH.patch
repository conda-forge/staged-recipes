From: Mark Harfouche <mark@ramonaoptics.com>
Subject: [PATCH] Support torch-style "X.Y+PTX" entries in NATTEN_CUDA_ARCH

NATTEN_BUILD_WITH_PTX=1 embeds PTX for every requested arch, which is
redundant for archs that already get SASS and costs build time. Accept
the TORCH_CUDA_ARCH_LIST convention instead, so e.g.
NATTEN_CUDA_ARCH="8.0;8.6;9.0;10.0;12.0+PTX" builds SASS for all archs
plus forward-compatible PTX for the newest one only.
Not upstreamed yet.

--- a/setup.py	2026-09-10 19:59:14.441031706 -0400
+++ b/setup.py	2026-09-10 19:59:14.447406656 -0400
@@ -143,13 +143,22 @@
     return version
 
 
+# Archs to also embed PTX for, requested torch-style as e.g. "12.0+PTX".
+PTX_ARCH_LIST: List[int] = []
+
+
 def _check_cuda_arch(arch: Any) -> int:
+    with_ptx = isinstance(arch, str) and arch.upper().endswith("+PTX")
+    if with_ptx:
+        arch = arch[: -len("+PTX")]
     try:
         arch = float(arch)
         arch = arch * 10  # 8.6 => 86
         assert (
             arch >= 30
         ), f"Only SM30 and above are supported at this time, got {arch}."
+        if with_ptx:
+            PTX_ARCH_LIST.append(int(arch))
         return int(arch)
     except ValueError:
         raise ValueError(f"Invalid architecture list {arch}.")
@@ -183,6 +192,14 @@
         )
 
         return real_tags + ";" + ptx_tags
+    if PTX_ARCH_LIST:
+        ptx_tags = ";".join(
+            [
+                (str(x) if x not in [90, 100, 103] else f"{x}a") + "-virtual"
+                for x in PTX_ARCH_LIST
+            ]
+        )
+        return real_tags + ";" + ptx_tags
     return real_tags
 
 
