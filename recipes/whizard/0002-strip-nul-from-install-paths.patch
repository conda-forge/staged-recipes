+    os_data%cflags         = strip_nul(DEFAULT_CFLAGS)
     os_data%cflags_pic     = DEFAULT_CFLAGS_PIC
     os_data%cxx            = DEFAULT_CXX
     os_data%cxxflags       = DEFAULT_CXXFLAGS
     os_data%cxxlibs        = DEFAULT_CXXLIBS
