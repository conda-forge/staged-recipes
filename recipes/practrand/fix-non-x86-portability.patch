+#elif defined(__GNUC__) && (defined(__i386__) || defined(__x86_64__))
 	return __rdtsc();
 #else
-	return std::chrono::high_resolution_clock();
+	return static_cast<Sint64>(
+		std::chrono::high_resolution_clock::now().time_since_epoch().count()
+	);
 #endif
 }

