From 5281ccc66016919d07749d540b4608c09b4562b9 Mon Sep 17 00:00:00 2001
From: Jay Kwak <82421531+jkwak-work@users.noreply.github.com>
Date: Fri, 24 Jul 2026 07:13:58 -0700
Subject: [PATCH] Add public latest capability aliases

Backport the source fix from
https://github.com/shader-slang/slang/commit/5281ccc66016919d07749d540b4608c09b4562b9

diff --git a/source/slang/slang-capabilities.capdef b/source/slang/slang-capabilities.capdef
index 7df001dff17..b00f519beda 100644
--- a/source/slang/slang-capabilities.capdef
+++ b/source/slang/slang-capabilities.capdef
@@ -1995,6 +1995,10 @@ alias sm_6_10 = sm_6_10_version
              | sm_6_9
              ;
 
+/// Represents the latest HLSL shader model version.
+/// [Version]
+alias sm_latest = _sm_6_10;
+
 // Profiles
 /// Use `sm_4_0` instead
 /// [Other]
@@ -2199,6 +2203,10 @@ alias GLSL_460 = _GLSL_460
                | GLSL_450
                ;
 
+/// Represents the latest GLSL version.
+/// [Version]
+alias GLSL_latest = _GLSL_460;
+
 /// User should not use this capability
 /// [Other]
 alias GLSL_410_SPIRV_1_0 = _GLSL_410 | spirv_1_0;
-- 
2.50.1

