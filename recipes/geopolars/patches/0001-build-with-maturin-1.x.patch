From: conda-forge
Subject: [PATCH] Build with maturin 1.x

The 0.1.0-alpha.4 release predates maturin 1.0 and needs three fixes to build
with a current maturin:

* `pyarrow>=4.0.*` is not a valid PEP 440 specifier ("operator >= cannot be
  used with a wildcard version specifier"); maturin 1.x rejects the whole
  pyproject.toml over it.
* The mixed Rust/Python layout is declared via `[package.metadata.maturin]` in
  Cargo.toml, which maturin 1.x no longer reads.  Without a `[tool.maturin]`
  `python-source` key maturin silently drops `python/geopolars/` from the wheel
  and ships only the compiled extension plus a generated
  `from .geopolars import *` shim, so `geopolars.GeoSeries` and the rest of the
  Python API are missing at runtime.
* Relax the `maturin>=0.13,<0.14` build requirement accordingly.

--- a/py-geopolars/pyproject.toml
+++ b/py-geopolars/pyproject.toml
@@ -1,5 +1,5 @@
 [build-system]
-requires = ["maturin>=0.13,<0.14"]
+requires = ["maturin>=1.0,<2"]
 build-backend = "maturin"
 
 [project]
@@ -8,7 +8,7 @@ version = "0.1.0-alpha.4"
 dependencies = [
   # Minimum version with binary dtype
   "polars>=0.14.19",
-  "pyarrow>=4.0.*",
+  "pyarrow>=4.0",
   "numpy >= 1.16.0",
   "importlib_resources; python_version < '3.11'",
 ]
@@ -30,6 +30,10 @@ classifiers = [
 [project.urls]
 repository = "https://github.com/geopolars/geopolars"
 
+[tool.maturin]
+python-source = "python"
+module-name = "geopolars.geopolars"
+
 [tool.isort]
 profile = "black"
 known_first_party = ["geopolars"]
